{
  "name": "llm-inference-visualizer",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter visualizer dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "mock": "pnpm --filter trace-mock cli",
    "mock-ollama-http": "pnpm --filter trace-mock http",
    "gen-fixtures": "pnpm --filter trace-mock gen-fixtures",
    "record": "pnpm --filter visualizer build && pnpm --filter visualizer record",
    "demo": "node scripts/make-demo.mjs",
    "record:demo": "pnpm record && pnpm demo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6",
    "typescript-eslint": "^8.72.1"
  }
}
