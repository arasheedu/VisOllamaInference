{
  "name": "trace-mock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts"
  },
  "bin": {
    "trace-mock": "src/cli.ts"
  },
  "scripts": {
