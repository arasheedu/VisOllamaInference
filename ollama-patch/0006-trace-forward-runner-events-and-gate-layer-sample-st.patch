diff --git a/trace/runner.go b/trace/runner.go
new file mode 100644
index 00000000..3d636adf
--- /dev/null
+++ b/trace/runner.go
@@ -0,0 +1,153 @@
+package trace
+
+import (
+	"context"
+	"time"
+)
+
+// runnerAckCap bounds acks buffered for llama-server step mode (layer and
+// sample granularity) before they are posted to the runner.
+const runnerAckCap = 1024
+
+// eventDetail mirrors EVENT_DETAIL in packages/trace-schema: the minimum
+// detail level at which each event type is emitted. Types not listed are
+// unknown to the schema and are never forwarded.
+var eventDetail = map[string]Detail{
+	"request.received":    Basic,
+	"model.load":          Basic,
+	"tokenize.done":       Basic,
+	"prefill.batch":       Basic,
+	"prefill.done":        Basic,
+	"decode.step.start":   Basic,
+	"decode.logits":       Basic,
+	"decode.sample":       Basic,
+	"decode.token":        Basic,
+	"request.done":        Basic,
+	"request.error":       Basic,
+	"step.timeout":        Basic,
+	"decode.layer":        Layers,
+	"tokenize.merge":      Full,
+	"prefill.layer":       Full,
+	"decode.op":           Full,
+	"decode.residual":     Full,
+	"decode.attn":         Full,
+	"decode.kv.write":     Full,
+	"decode.sample.stage": Full,
+	"stream.chunk":        Full,
+	"decode.moe":          Full,
+}
+
+// SetRunnerPatched records whether the llama-server behind this request has
+// the visualizer trace patch. Call it before Received: it decides the
+// capabilities reported there.
+func (t *RequestTracer) SetRunnerPatched(patched bool) {
+	if t != nil {
+		t.runnerPatched = patched
+	}
+}
+
+// RunnerStep returns "layer" or "sample" when this request holds step mode
+// at a granularity that llama-server gates itself, else "".
+func (t *RequestTracer) RunnerStep() string {
+	if t == nil || t.runnerAcks == nil {
+		return ""
+	}
+	return t.stepReq
+}
+
+// WantsRunnerTrace reports whether llama-server should be asked for its own
+// trace events: at layers/full detail, or for layer/sample step mode.
+func (t *RequestTracer) WantsRunnerTrace() bool {
+	return t != nil && (t.detail >= Layers || t.RunnerStep() != "")
+}
+
+// Allowed reports whether a runner event of type typ is forwarded at this
+// request's detail level. Step mode at layer (sample) granularity also lets
+// decode.layer (decode.sample.stage) through, since those are what the
+// runner pauses on.
+func (t *RequestTracer) Allowed(typ string) bool {
+	if t == nil {
+		return false
+	}
+	d, ok := eventDetail[typ]
+	if !ok {
+		return false
+	}
+	if d <= t.detail {
+		return true
+	}
+	switch t.RunnerStep() {
+	case "layer":
+		return typ == "decode.layer"
+	case "sample":
+		return typ == "decode.sample.stage"
+	}
+	return false
+}
+
+// Now returns the tracer clock (ns since the emitter started), the time base
+// of every t_ns.
+func (t *RequestTracer) Now() int64 {
+	if t == nil {
+		return 0
+	}
+	return time.Since(t.e.base).Nanoseconds()
+}
+
+// Forward emits an event produced by llama-server. body is its payload as a
+// JSON object without v/req/seq/t_ns/type; tns is already on the tracer
+// clock. Events not allowed at this detail level are dropped.
+func (t *RequestTracer) Forward(typ string, body []byte, tns int64) {
+	if t == nil || !t.Allowed(typ) || len(body) < 2 || body[0] != '{' {
+		return
+	}
+	t.emitBody(typ, body, tns)
+}
+
+// StepStartAt is StepStart with an explicit t_ns (tracer clock, < 0 = now),
+// used when llama-server reports when the step's forward pass began.
+func (t *RequestTracer) StepStartAt(ctx context.Context, kvUsed, kvTotal int, tns int64) int {
+	if t == nil {
+		return 0
+	}
+	return t.stepStartAt(ctx, kvUsed, kvTotal, tns)
+}
+
+// CurrentStep returns the current decode step, -1 before the first.
+func (t *RequestTracer) CurrentStep() int {
+	if t == nil {
+		return -1
+	}
+	return t.step
+}
+
+// RunnerAcks returns the acks to pass on to llama-server's POST /trace/ack
+// (true = continue), or nil when the runner does not gate this request.
+func (t *RequestTracer) RunnerAcks() <-chan bool {
+	if t == nil || !t.runnerStepping.Load() {
+		return nil
+	}
+	return t.runnerAcks
+}
+
+// DisableRunnerStep falls back to the Go token gate, for a runner that turned
+// out not to support step mode. Acks already received count as one token.
+func (t *RequestTracer) DisableRunnerStep() {
+	if t == nil || !t.runnerStepping.CompareAndSwap(true, false) {
+		return
+	}
+	for {
+		select {
+		case cont := <-t.runnerAcks:
+			t.ack(cont)
+		default:
+			return
+		}
+	}
+}
+
+// HubConnected reports whether the visualizer socket is up. Step mode never
+// waits for acks while it is down.
+func (t *RequestTracer) HubConnected() bool {
+	return t != nil && t.e.connected.Load()
+}
diff --git a/trace/runner_test.go b/trace/runner_test.go
new file mode 100644
index 00000000..7a8a736b
--- /dev/null
+++ b/trace/runner_test.go
@@ -0,0 +1,152 @@
+package trace
+
+import (
+	"context"
+	"slices"
+	"testing"
+	"time"
+)
+
+func TestCapabilitiesWithPatchedRunner(t *testing.T) {
+	e := testEmitter(t)
+	for _, tc := range []struct {
+		detail, step string
+		patched      bool
+		want         []string
+	}{
+		{"full", "", true, []string{"no_tokenize_merge"}},
+		{"layers", "", true, []string{"no_tokenize_merge"}},
+		{"basic", "", true, []string{"no_tokenize_merge", "prefill_synthesized"}},
+		{"basic", "layer", true, []string{"no_tokenize_merge"}},
+		{"full", "", false, []string{"no_layers", "no_ops", "no_residual", "no_attn", "no_kv_writes", "no_sample_stages", "no_tokenize_merge", "prefill_synthesized"}},
+		{"full", "sample", false, []string{"no_layers", "no_ops", "no_residual", "no_attn", "no_kv_writes", "no_sample_stages", "no_tokenize_merge", "prefill_synthesized", "step_token_only"}},
+	} {
+		tr := e.newRequest("caps-"+tc.detail+tc.step, tc.detail, tc.step)
+		tr.SetRunnerPatched(tc.patched)
+		if got := tr.Capabilities(); !slices.Equal(got, tc.want) {
+			t.Errorf("%s/%s patched=%v: %v, want %v", tc.detail, tc.step, tc.patched, got, tc.want)
+		}
+		tr.End(true, "")
+		drain(e)
+	}
+}
+
+func TestAllowedFollowsDetail(t *testing.T) {
+	e := testEmitter(t)
+	layers := e.newRequest("a1", "layers", "")
+	full := e.newRequest("a2", "full", "")
+	for typ, want := range map[string][2]bool{
+		"decode.sample":       {true, true},
+		"prefill.batch":       {true, true},
+		"step.timeout":        {true, true},
+		"decode.layer":        {true, true},
+		"decode.op":           {false, true},
+		"decode.attn":         {false, true},
+		"decode.sample.stage": {false, true},
+		"decode.moe":          {false, true},
+		"bogus":               {false, false},
+	} {
+		if got := [2]bool{layers.Allowed(typ), full.Allowed(typ)}; got != want {
+			t.Errorf("%s: layers/full = %v, want %v", typ, got, want)
+		}
+	}
+
+	// Step mode lets through what the runner pauses on.
+	sample := e.newRequest("a3", "layers", "sample")
+	if !sample.Allowed("decode.sample.stage") || sample.Allowed("decode.op") {
+		t.Error("sample step at layers detail")
+	}
+	sample.End(true, "")
+	layer := e.newRequest("a4", "basic", "layer")
+	if !layer.Allowed("decode.layer") || layer.Allowed("decode.op") || !layer.WantsRunnerTrace() {
+		t.Error("layer step at basic detail")
+	}
+	layer.End(true, "")
+	if e.newRequest("a5", "basic", "").WantsRunnerTrace() {
+		t.Error("basic detail wants runner trace")
+	}
+}
+
+func TestForwardKeepsTimeOrder(t *testing.T) {
+	e := testEmitter(t)
+	e.base = time.Now().Add(-time.Second) // so t0+20 is not in the future on a coarse clock
+	tr := e.newRequest("fwd", "full", "")
+	ctx := context.Background()
+	t0 := tr.Now() - 1_000_000 // 1 ms ago: rebased runner times are in the past
+	tr.Forward("decode.layer", []byte(`{"step":0,"layer":0,"ms":1}`), t0)
+	tr.StepStartAt(ctx, 1, 10, t0+10)
+	tr.Forward("decode.layer", []byte(`{"step":0,"layer":1,"ms":1}`), t0+20)
+	tr.Forward("decode.op", []byte(`{"step":0,"layer":1,"op":"norm","ms":1}`), t0+15) // earlier than previous: clamped
+	tr.Forward("decode.layer", []byte(`{"step":0,"layer":2,"ms":1}`), tr.Now()+int64(time.Hour))
+	tr.Forward("decode.layer", []byte(`not an object`), t0)
+	tr.Forward("not.a.type", []byte(`{"step":0}`), t0)
+
+	evs := drain(e)
+	if len(evs) != 5 {
+		t.Fatalf("got %d events: %v", len(evs), evs)
+	}
+	var last float64
+	for i, ev := range evs {
+		if ev["seq"] != float64(i) {
+			t.Errorf("seq %v at %d", ev["seq"], i)
+		}
+		ts := ev["t_ns"].(float64)
+		if ts < last {
+			t.Errorf("t_ns backwards at %d", i)
+		}
+		last = ts
+	}
+	if evs[0]["t_ns"].(float64) != float64(t0) {
+		t.Errorf("first t_ns = %v, want %d", evs[0]["t_ns"], t0)
+	}
+	if evs[2]["t_ns"].(float64) != float64(t0+20) || evs[3]["t_ns"].(float64) != float64(t0+20) {
+		t.Errorf("rebased t_ns = %v, %v; want %d twice", evs[2]["t_ns"], evs[3]["t_ns"], t0+20)
+	}
+	if evs[4]["t_ns"].(float64) > float64(tr.Now()) {
+		t.Error("t_ns in the future")
+	}
+}
+
+func TestRunnerStepAcks(t *testing.T) {
+	e := testEmitter(t)
+	e.connected.Store(true)
+	tr := e.newRequest("rs", "full", "layer")
+	if tr.RunnerStep() != "layer" || tr.RunnerAcks() == nil {
+		t.Fatal("layer step not gated by the runner")
+	}
+	// The Go token gate is off: StepStart does not wait.
+	done := make(chan struct{})
+	go func() { tr.StepStart(context.Background(), 0, 0); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("token gate applied in layer step mode")
+	}
+	e.handleControl([]byte(`{"v":1,"type":"ack","req":"rs","granularity":"layer"}`))
+	e.handleControl([]byte(`{"v":1,"type":"ack","req":"rs","continue":true}`))
+	acks := tr.RunnerAcks()
+	if a := <-acks; a {
+		t.Error("first ack is a continue")
+	}
+	if a := <-acks; !a {
+		t.Error("continue not passed on")
+	}
+	tr.End(true, "")
+
+	// A runner without step support: back to the token gate, and an ack
+	// that arrived meanwhile counts as one token.
+	tr = e.newRequest("rs2", "full", "sample")
+	e.handleControl([]byte(`{"v":1,"type":"ack","req":"rs2"}`))
+	tr.DisableRunnerStep()
+	if tr.RunnerAcks() != nil {
+		t.Error("runner acks after DisableRunnerStep")
+	}
+	done = make(chan struct{})
+	go func() { tr.StepStart(context.Background(), 0, 0); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(500 * time.Millisecond):
+		t.Fatal("buffered ack did not release the token gate")
+	}
+	tr.End(true, "")
+}
