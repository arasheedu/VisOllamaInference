+// emitBody emits a marshalled payload object. tns < 0 means now. t_ns never
+// goes backwards in seq order and never runs ahead of the clock.
+func (t *RequestTracer) emitBody(typ string, body []byte, tns int64) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	now := time.Since(t.e.base).Nanoseconds()
+	if tns < 0 || tns > now {
+		tns = now
+	}
+	if tns < t.lastT {
+		tns = t.lastT
+	}
+	t.lastT = tns
+	seq := t.seq
+	t.seq++
 
 	buf := make([]byte, 0, 64+len(t.reqJSON)+len(typ)+len(body))
 	buf = append(buf, `{"v":1,"req":`...)
