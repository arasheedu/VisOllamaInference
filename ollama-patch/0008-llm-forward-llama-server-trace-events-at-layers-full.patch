+// A full-detail /completion stream: prefill events out of t_ns order, a
+// trace-only chunk, forward-pass events per step and llama-server's own
+// decode.sample, which replaces the synthesized one.
+func TestRunnerTraceCompletionFull(t *testing.T) {
+	h := traceTestHub(t)
+	const T = int64(1_000_000_000)
+	ts := func(d int64) int64 { return T + d }
+	f, r := newFakeLlamaServer(t, true, func(w io.Writer, flush func(), _ <-chan map[string]any) {
+		sse(w, flush,
+			fmt.Sprintf(`{"content":"Hi","stop":false,"timings":{"cache_n":0,"prompt_n":4,"prompt_ms":2,"predicted_n":1,"predicted_ms":1},`+
+				`"completion_probabilities":[{"id":5,"token":"Hi","logprob":-0.1,"top_logprobs":[{"id":5,"token":"Hi","logprob":-0.1}]}],`+
+				`"__trace_t_ns":%d,"__trace_caps":[],"__trace_slot":0,"__trace":[`+
+				`{"type":"prefill.layer","t_ns":%d,"batch_i":0,"layer":0,"ms":0.1},`+
+				`{"type":"prefill.layer","t_ns":%d,"batch_i":1,"layer":0,"ms":0.1},`+
+				`{"type":"prefill.batch","t_ns":%d,"batch_i":0,"of":2,"from":0,"to":2,"ms":1},`+
+				`{"type":"prefill.batch","t_ns":%d,"batch_i":1,"of":2,"from":2,"to":4,"ms":1},`+
+				`{"type":"prefill.done","t_ns":%d,"n_tokens":4,"ms":2},`+
+				`{"type":"decode.sample.stage","t_ns":%d,"step":1,"stage":"raw","candidates":[{"id":5,"v":3}],"cutoff":100},`+
+				`{"type":"decode.sample","t_ns":%d,"step":1,"chosen_id":77,"temp":0.8,"top_p":0.9,"top_k":40,"method":"dist"}]}`,
+				ts(10_000), ts(100), ts(2_000), ts(50), ts(1_900), ts(2_100), ts(2_200), ts(2_300)),
+			fmt.Sprintf(`{"content":"","tokens":[],"stop":false,"__trace_t_ns":%d,"__trace":[`+
+				`{"type":"decode.layer","t_ns":%d,"step":2,"layer":0,"ms":0.5,"device":"CUDA0","norm":1.5},`+
+				`{"type":"decode.op","t_ns":%d,"step":2,"layer":0,"op":"norm","ms":0.1}]}`, ts(20_000), ts(19_000), ts(19_100)),
+			fmt.Sprintf(`{"content":" there","stop":false,"timings":{"predicted_n":2,"predicted_ms":2},`+
+				`"completion_probabilities":[{"id":6,"token":" there","logprob":-0.2,"top_logprobs":[{"id":6,"token":" there","logprob":-0.2}]}],`+
+				`"__trace_t_ns":%d,"__trace":[`+
+				`{"type":"decode.layer","t_ns":%d,"step":2,"layer":1,"ms":0.5,"device":"CUDA0","norm":1.6},`+
+				`{"type":"decode.sample","t_ns":%d,"step":2,"chosen_id":78,"temp":0.8,"top_p":0.9,"top_k":40,"method":"dist"}]}`, ts(30_000), ts(29_000), ts(29_500)),
+			fmt.Sprintf(`{"content":"","stop":true,"stop_type":"eos","timings":{"cache_n":0,"prompt_n":4,"prompt_ms":2,"predicted_n":3,"predicted_ms":3},`+
+				`"__trace_t_ns":%d,"__trace":[{"type":"decode.sample","t_ns":%d,"step":3,"chosen_id":128009,"temp":0.8,"top_p":0.9,"top_k":40,"method":"dist"}]}`, ts(40_000), ts(39_000)),
+		)
+	})
+
+	evs := tracedCompletion(t, r, "rt-full", "full", "")
+	checkEnvelope(t, evs)
+
+	tr := f.traceField()
+	if tr == nil || tr["detail"] != "full" || tr["layer_stride"] != float64(4) || tr["attn_layers"] != float64(4) || tr["attn_heads"] != false {
+		t.Fatalf("trace request = %v", tr)
+	}
+	if _, ok := tr["step"]; ok {
+		t.Errorf("step sent without step mode: %v", tr)
+	}
+
+	c := countTypes(evs)
+	want := map[string]int{
+		"request.received": 1, "tokenize.done": 1, "prefill.layer": 2, "prefill.batch": 2, "prefill.done": 1,
+		"decode.step.start": 3, "decode.sample.stage": 1, "decode.logits": 3, "decode.sample": 3,
+		"decode.layer": 2, "decode.op": 1, "decode.token": 3, "stream.chunk": 2, "request.done": 1,
+	}
+	for k, v := range want {
+		if c[k] != v {
+			t.Errorf("%s: got %d, want %d (all: %v)", k, c[k], v, c)
+		}
+	}
+
+	// prefill.batch is sorted into time order, and t_ns differences inside a
+	// chunk survive the rebase.
+	var order []string
+	var tLayer0, tLayer1 float64
+	chosen := map[float64]float64{}
+	step := -1.0
+	for _, e := range evs {
+		switch e["type"] {
+		case "prefill.layer", "prefill.batch", "prefill.done":
+			order = append(order, fmt.Sprintf("%s%v", e["type"], e["batch_i"]))
+			if e["type"] == "prefill.layer" && e["batch_i"] == float64(0) {
+				tLayer0 = e["t_ns"].(float64)
+			}
+			if e["type"] == "prefill.layer" && e["batch_i"] == float64(1) {
+				tLayer1 = e["t_ns"].(float64)
+			}
+		case "decode.step.start":
+			step = e["step"].(float64)
+		case "decode.sample":
+			chosen[e["step"].(float64)] = e["chosen_id"].(float64)
+		}
+		if s, ok := e["step"].(float64); ok && s > step {
+			t.Errorf("%s for step %v before its decode.step.start", e["type"], s)
+		}
+	}
+	if got := strings.Join(order, ","); got != "prefill.batch0,prefill.layer0,prefill.batch1,prefill.layer1,prefill.done<nil>" {
+		t.Errorf("prefill order = %s", got)
+	}
+	if d := tLayer1 - tLayer0; d != 1_900 {
+		t.Errorf("rebased prefill.layer gap = %v ns, want 1900", d)
+	}
+	if chosen[0] != 77 || chosen[1] != 78 || chosen[2] != 128009 {
+		t.Errorf("decode.sample chosen = %v, want llama-server's 77/78/128009", chosen)
+	}
+	for _, e := range evs {
+		if e["type"] == "decode.layer" && e["step"] != float64(1) {
+			t.Errorf("decode.layer step %v, want 1 (llama-server step 2)", e["step"])
+		}
+		if e["type"] == "decode.token" && e["step"] == float64(2) && e["is_eos"] != true {
+			t.Errorf("EOS step token = %v", e)
+		}
+		if e["type"] == "request.received" {
+			if caps := fmt.Sprint(e["capabilities"]); strings.Contains(caps, "no_layers") {
+				t.Errorf("capabilities = %s", caps)
+			}
+		}
+	}
+	_ = h
+}
