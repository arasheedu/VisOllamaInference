+// Layer step mode: llama-server pauses, the trace-only chunk's events reach
+// the hub before the pause ends, the hub's ack is forwarded to POST
+// /trace/ack, and the end of the request sends continue.
+func TestRunnerTraceLayerStepForwardsAcks(t *testing.T) {
+	h := traceTestHub(t)
+	const req = "rt-step"
+	h.mu.Lock()
+	h.onEv[req] = func(ev map[string]any) {
+		if ev["type"] == "decode.layer" {
+			go h.ack(req, false)
+		}
+	}
+	h.mu.Unlock()
+
+	f, r := newFakeLlamaServer(t, true, func(w io.Writer, flush func(), acks <-chan map[string]any) {
+		sse(w, flush, `{"content":"A","stop":false,"timings":{"predicted_n":1},"__trace_t_ns":100,"__trace_slot":3,"__trace_caps":[],"__trace":[{"type":"prefill.done","t_ns":10,"n_tokens":1,"ms":1}]}`)
+		for layer := range 2 {
+			sse(w, flush, fmt.Sprintf(`{"content":"","tokens":[],"stop":false,"__trace_t_ns":%d,"__trace":[{"type":"decode.layer","t_ns":%d,"step":2,"layer":%d,"ms":0.5}]}`, 200+layer, 150+layer, layer))
+			select {
+			case a := <-acks:
+				if a["continue"] == true {
+					t.Errorf("pause %d released by continue", layer)
+				}
+			case <-time.After(3 * time.Second):
+				t.Errorf("no ack forwarded for pause %d", layer)
+				return
+			}
+		}
+		sse(w, flush, `{"content":"B","stop":false,"timings":{"predicted_n":2}}`, `{"content":"","stop":true,"stop_type":"limit","timings":{"predicted_n":2}}`)
+	})
+	evs := tracedCompletion(t, r, req, "basic", "layer")
+	checkEnvelope(t, evs)
+
+	tr := f.traceField()
+	if tr["step"] != "layer" || tr["detail"] != "layers" || tr["step_timeout_ms"] == nil {
+		t.Errorf("trace request = %v", tr)
+	}
+	if c := countTypes(evs); c["decode.layer"] != 2 || c["decode.step.start"] != 2 {
+		t.Errorf("counts %v", c)
+	}
+	f.mu.Lock()
+	acks := append([]map[string]any(nil), f.acks...)
+	f.mu.Unlock()
+	if len(acks) != 3 {
+		t.Fatalf("acks = %v, want 2 acks and a final continue", acks)
+	}
+	for i, a := range acks {
+		if a["id_slot"] != float64(3) {
+			t.Errorf("ack %d id_slot = %v, want 3", i, a["id_slot"])
+		}
+	}
+	if acks[2]["continue"] != true {
+		t.Errorf("last ack = %v, want continue", acks[2])
+	}
+}
+
+// A visualizer "continue" is forwarded as-is.
+func TestRunnerTraceContinueForwarded(t *testing.T) {
+	h := traceTestHub(t)
+	const req = "rt-continue"
+	h.mu.Lock()
+	h.onEv[req] = func(ev map[string]any) {
+		if ev["type"] == "decode.layer" {
+			go h.ack(req, true)
+		}
+	}
+	h.mu.Unlock()
+	f, r := newFakeLlamaServer(t, true, func(w io.Writer, flush func(), acks <-chan map[string]any) {
+		sse(w, flush, `{"content":"A","stop":false,"timings":{"predicted_n":1},"__trace_t_ns":100,"__trace_slot":0,"__trace":[{"type":"decode.layer","t_ns":50,"step":2,"layer":0,"ms":0.5}]}`)
+		select {
+		case a := <-acks:
+			if a["continue"] != true {
+				t.Errorf("ack = %v, want continue", a)
+			}
+		case <-time.After(3 * time.Second):
+			t.Error("continue not forwarded")
+		}
+		sse(w, flush, `{"content":"","stop":true,"stop_type":"limit","timings":{"predicted_n":1}}`)
+	})
+	tracedCompletion(t, r, req, "layers", "layer")
+	f.mu.Lock()
+	n := len(f.acks)
+	f.mu.Unlock()
+	if n != 2 { // the visualizer's continue, then the end-of-request continue
+		t.Errorf("acks = %d, want 2", n)
+	}
+}
