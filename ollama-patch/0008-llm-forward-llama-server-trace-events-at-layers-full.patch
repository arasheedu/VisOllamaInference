+// Without runner tracing (basic detail, a stock runner or tracing disabled)
+// the llama-server request has no trace field.
+func TestRunnerTraceNotRequested(t *testing.T) {
+	traceTestHub(t)
+	plain := func(w io.Writer, flush func(), _ <-chan map[string]any) {
+		sse(w, flush, `{"content":"A","stop":false,"timings":{"predicted_n":1}}`, `{"content":"","stop":true,"stop_type":"eos","timings":{"predicted_n":2}}`)
+	}
+
+	f, r := newFakeLlamaServer(t, true, plain)
+	evs := tracedCompletion(t, r, "rt-basic", "basic", "")
+	if bytes.Contains(f.body, []byte(`"trace"`)) {
+		t.Errorf("basic detail sent trace: %s", f.body)
+	}
+	if c := countTypes(evs); c["prefill.batch"] != 1 || c["decode.sample"] != 2 {
+		t.Errorf("basic counts %v", c)
+	}
+
+	// A stock runner falls back to the token gate, so the hub acks tokens.
+	hub.mu.Lock()
+	hub.onEv["rt-stock"] = func(ev map[string]any) {
+		if ev["type"] == "request.received" || ev["type"] == "decode.step.start" {
+			go hub.ack("rt-stock", false)
+		}
+	}
+	hub.mu.Unlock()
+	f, r = newFakeLlamaServer(t, false, plain)
+	tracedCompletion(t, r, "rt-stock", "full", "layer")
+	if bytes.Contains(f.body, []byte(`"trace"`)) {
+		t.Errorf("stock runner got trace: %s", f.body)
+	}
+
+	f, r = newFakeLlamaServer(t, true, plain)
+	opts := api.DefaultOptions()
+	if err := r.Completion(t.Context(), CompletionRequest{Prompt: "Hi", Options: &opts}, func(CompletionResponse) {}); err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(f.body, []byte(`"trace"`)) || bytes.Contains(f.body, []byte(`timings_per_token`)) {
+		t.Errorf("untraced request changed: %s", f.body)
+	}
+}
