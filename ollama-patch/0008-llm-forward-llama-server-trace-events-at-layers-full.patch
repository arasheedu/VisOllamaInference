+// At layers detail, full-tier runner events are not forwarded.
+func TestRunnerTraceLayersFiltersFullTier(t *testing.T) {
+	traceTestHub(t)
+	f, r := newFakeLlamaServer(t, true, func(w io.Writer, flush func(), _ <-chan map[string]any) {
+		sse(w, flush,
+			`{"content":"A","stop":false,"timings":{"predicted_n":1},"__trace_t_ns":100,"__trace":[{"type":"prefill.done","t_ns":10,"n_tokens":1,"ms":1},{"type":"decode.sample","t_ns":20,"step":1,"chosen_id":1,"temp":0.8,"top_p":0.9,"top_k":40,"method":"dist"}]}`,
+			`{"content":"B","stop":false,"timings":{"predicted_n":2},"__trace_t_ns":200,"__trace":[`+
+				`{"type":"decode.layer","t_ns":150,"step":2,"layer":0,"ms":0.5},`+
+				`{"type":"decode.op","t_ns":151,"step":2,"layer":0,"op":"norm","ms":0.1},`+
+				`{"type":"decode.attn","t_ns":152,"step":2,"layer":0,"top":[{"pos":0,"w":1}]},`+
+				`{"type":"decode.sample.stage","t_ns":153,"step":2,"stage":"raw","candidates":[]},`+
+				`{"type":"not.a.type","t_ns":154,"step":2},`+
+				`{"type":"decode.sample","t_ns":160,"step":2,"chosen_id":2,"temp":0.8,"top_p":0.9,"top_k":40,"method":"dist"}]}`,
+			`{"content":"","stop":true,"stop_type":"limit","timings":{"predicted_n":2}}`,
+		)
+	})
+	evs := tracedCompletion(t, r, "rt-layers", "layers", "")
+	checkEnvelope(t, evs)
+	if f.traceField()["detail"] != "layers" {
+		t.Errorf("trace = %v", f.traceField())
+	}
+	c := countTypes(evs)
+	for _, typ := range []string{"decode.op", "decode.attn", "decode.sample.stage", "not.a.type", "stream.chunk"} {
+		if c[typ] != 0 {
+			t.Errorf("%s forwarded at layers detail", typ)
+		}
+	}
+	if c["decode.layer"] != 1 || c["decode.sample"] != 2 || c["decode.step.start"] != 2 {
+		t.Errorf("counts %v", c)
+	}
+}
