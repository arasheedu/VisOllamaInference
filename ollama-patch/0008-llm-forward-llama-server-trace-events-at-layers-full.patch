+// Native chat: a chunk with "choices":[] that only carries __trace, and the
+// last events on a chunk after the finish_reason chunk.
+func TestRunnerTraceChatChunks(t *testing.T) {
+	h := traceTestHub(t)
+	_, r := newFakeLlamaServer(t, true, func(w io.Writer, flush func(), _ <-chan map[string]any) {
+		sse(w, flush,
+			`{"choices":[{"delta":{"content":"Hi"},"logprobs":{"content":[{"id":5,"token":"Hi","logprob":-0.1,"top_logprobs":[]}]}}],"timings":{"predicted_n":1},"__trace_t_ns":100,"__trace_slot":0,"__trace_caps":["no_attn"],"__trace":[{"type":"prefill.batch","t_ns":10,"batch_i":0,"of":1,"from":0,"to":3,"ms":1},{"type":"prefill.done","t_ns":11,"n_tokens":3,"ms":1},{"type":"decode.sample","t_ns":20,"step":1,"chosen_id":5,"temp":0.8,"top_p":0.9,"top_k":40,"method":"dist"}]}`,
+			`{"choices":[],"object":"chat.completion.chunk","__trace_t_ns":200,"__trace":[{"type":"decode.layer","t_ns":150,"step":2,"layer":0,"ms":0.5},{"type":"decode.sample","t_ns":160,"step":2,"chosen_id":128009,"temp":0.8,"top_p":0.9,"top_k":40,"method":"dist"}]}`,
+			`{"choices":[{"delta":{},"finish_reason":"stop"}],"timings":{"predicted_n":2,"predicted_ms":2}}`,
+			`{"choices":[],"usage":{},"__trace_t_ns":300,"__trace":[{"type":"decode.residual","t_ns":170,"step":2,"layer":0,"norm":1,"delta_norm":0.5}]}`,
+			`[DONE]`,
+		)
+	})
+	tr := trace.NewRequest("rt-chat", "full", "")
+	tr.SetRunnerPatched(true)
+	tr.Received("m", 2, nil)
+	ctx := trace.NewContext(t.Context(), tr)
+	opts := api.DefaultOptions()
+	var text string
+	err := r.Chat(ctx, ChatRequest{Messages: []api.Message{{Role: "user", Content: "hi"}}, Options: &opts}, func(cr ChatResponse) {
+		text += cr.Message.Content
+		tr.Token(ctx, cr.Message.Content, cr.Done)
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	tr.End(true, "")
+	evs := h.wait(t, "rt-chat")
+	checkEnvelope(t, evs)
+	c := countTypes(evs)
+	if text != "Hi" || c["decode.step.start"] != 2 || c["decode.sample"] != 2 || c["decode.layer"] != 1 || c["decode.residual"] != 1 || c["prefill.batch"] != 1 {
+		t.Errorf("text %q counts %v", text, c)
+	}
+	for _, e := range evs {
+		if e["type"] == "decode.sample" && e["step"] == float64(1) && e["chosen_id"] != float64(128009) {
+			t.Errorf("EOS sample = %v", e)
+		}
+		if e["type"] == "decode.token" && e["step"] == float64(1) && e["is_eos"] != true {
+			t.Errorf("EOS token = %v", e)
+		}
+	}
+}
