--- /dev/null
+++ b/llm/llama_server_runner_trace.go
@@ -0,0 +1,495 @@
+package llm
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"log/slog"
+	"math"
+	"net/http"
+	"os"
+	"path/filepath"
+	"slices"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/ollama/ollama/envconfig"
+)
+
+// A llama-server built with the visualizer trace patch (llama/compat/
+// 100-visualizer-trace.patch) accepts a "trace" object on completion
+// requests, attaches its own events to the streamed chunks (__trace,
+// __trace_t_ns, __trace_caps, __trace_slot) and gates layer/sample step mode
+// with POST /trace/ack. Ollama forwards those events through the request
+// tracer, adding req/seq and rebasing t_ns onto its own clock.
+
+// runnerTraceRequest is the "trace" object of a llama-server request.
+type runnerTraceRequest struct {
+	Detail        string `json:"detail"`
+	LayerStride   uint   `json:"layer_stride"`
+	AttnLayers    uint   `json:"attn_layers"`
+	AttnHeads     bool   `json:"attn_heads"`
+	Step          string `json:"step,omitempty"`
+	StepTimeoutMS int64  `json:"step_timeout_ms,omitempty"`
+}
+
+// runnerTraceChunk holds the trace fields of one streamed llama-server chunk.
+type runnerTraceChunk struct {
+	Trace []json.RawMessage `json:"__trace,omitempty"`
+	TNs   *int64            `json:"__trace_t_ns,omitempty"`
+	Caps  []string          `json:"__trace_caps,omitempty"`
+	Slot  *int              `json:"__trace_slot,omitempty"`
+}
+
+func (c *runnerTraceChunk) merge(o runnerTraceChunk) {
+	c.Trace = append(c.Trace, o.Trace...)
+	if o.TNs != nil {
+		c.TNs = o.TNs
+	}
+	if o.Caps != nil {
+		c.Caps = o.Caps
+	}
+	if o.Slot != nil {
+		c.Slot = o.Slot
+	}
+}
+
+// runnerEvent is one event from __trace with its step already converted to
+// Ollama's 0-based numbering (-1 for events without a step).
+type runnerEvent struct {
+	typ  string
+	tns  int64 // llama-server steady clock
+	step int
+	body []byte // payload without type and t_ns
+}
+
+// parseRunnerEvent converts a llama-server event. llama-server numbers steps
+// from 1 (the first generated token); Ollama's tracer, and the visualizer,
+// from 0.
+func parseRunnerEvent(raw json.RawMessage) (runnerEvent, error) {
+	var m map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &m); err != nil {
+		return runnerEvent{}, err
+	}
+	ev := runnerEvent{step: -1}
+	if err := json.Unmarshal(m["type"], &ev.typ); err != nil || ev.typ == "" {
+		return runnerEvent{}, fmt.Errorf("trace event without type: %s", raw)
+	}
+	var tns float64
+	if err := json.Unmarshal(m["t_ns"], &tns); err != nil {
+		return runnerEvent{}, fmt.Errorf("trace event without t_ns: %s", raw)
+	}
+	ev.tns = int64(tns)
+	delete(m, "type")
+	delete(m, "t_ns")
+	for _, k := range []string{"v", "req", "seq"} {
+		delete(m, k)
+	}
+	if s, ok := m["step"]; ok {
+		var step int
+		if err := json.Unmarshal(s, &step); err != nil {
+			return runnerEvent{}, fmt.Errorf("trace event with bad step: %s", raw)
+		}
+		ev.step = max(step-1, 0)
+		m["step"] = json.RawMessage(fmt.Appendf(nil, "%d", ev.step))
+	}
+	body, err := json.Marshal(m)
+	if err != nil {
+		return runnerEvent{}, err
+	}
+	ev.body = body
+	return ev, nil
+}
+
+// ---- capability detection -------------------------------------------------
+
+// runnerTraceState caches whether llama-server has the trace patch: 0 not
+// known yet, 1 patched, 2 stock. A runner probe overrides the binary scan.
+var (
+	runnerTraceState atomic.Int32
+	runnerTraceScan  sync.Once
+)
+
+const runnerTraceMarker = "__trace_caps"
+
+// RunnerTraceSupported reports whether llama-server runners support the
+// visualizer trace protocol. It is needed before any runner is up (for
+// request.received), so until a runner has been probed it is answered by
+// looking for the protocol's field name in the llama-server binaries.
+func RunnerTraceSupported() bool {
+	if s := runnerTraceState.Load(); s != 0 {
+		return s == 1
+	}
+	runnerTraceScan.Do(func() {
+		patched := scanLlamaServerForTrace()
+		runnerTraceState.CompareAndSwap(0, map[bool]int32{true: 1, false: 2}[patched])
+		slog.Info("llama-server trace support", "patched", patched, "source", "binary scan")
+	})
+	return runnerTraceState.Load() == 1
+}
+
+func scanLlamaServerForTrace() bool {
+	exe, err := FindLlamaServer()
+	if err != nil {
+		return false
+	}
+	files := []string{exe}
+	for _, pat := range []string{"*llama-server-impl*", "*llama-server*.dll", "*llama-server*.so", "*llama-server*.dylib"} {
+		m, _ := filepath.Glob(filepath.Join(filepath.Dir(exe), pat))
+		files = append(files, m...)
+	}
+	slices.Sort(files)
+	for _, f := range slices.Compact(files) {
+		if data, err := os.ReadFile(f); err == nil && bytes.Contains(data, []byte(runnerTraceMarker)) {
+			return true
+		}
+	}
+	return false
+}
+
+// probeTrace asks this runner once whether it has the trace patch. POST
+// /trace/ack to a slot that cannot exist is answered 409 by a patched
+// llama-server (whether or not another request is stepping, and without
+// counting as an ack) and 404 by a stock one.
+func (s *llamaServerRunner) probeTrace(ctx context.Context) bool {
+	s.traceProbeOnce.Do(func() {
+		ctx, cancel := context.WithTimeout(ctx, 2*time.Second)
+		defer cancel()
+		code, err := s.postTraceAck(ctx, map[string]any{"id_slot": math.MaxInt32})
+		s.tracePatched = err == nil && code == http.StatusConflict
+		if err == nil {
+			runnerTraceState.Store(map[bool]int32{true: 1, false: 2}[s.tracePatched])
+		}
+		slog.Info("llama-server trace support", "patched", s.tracePatched, "source", "probe", "status", code, "error", err)
+	})
+	return s.tracePatched
+}
+
+var traceAckClient = &http.Client{Timeout: 5 * time.Second}
+
+func (s *llamaServerRunner) postTraceAck(ctx context.Context, body map[string]any) (int, error) {
+	data, err := json.Marshal(body)
+	if err != nil {
+		return 0, err
+	}
+	r, err := http.NewRequestWithContext(ctx, http.MethodPost, fmt.Sprintf("http://127.0.0.1:%d/trace/ack", s.port), bytes.NewReader(data))
+	if err != nil {
+		return 0, err
+	}
+	r.Header.Set("Content-Type", "application/json")
+	resp, err := traceAckClient.Do(r)
+	if err != nil {
+		return 0, err
+	}
+	resp.Body.Close()
+	return resp.StatusCode, nil
+}
+
+// ---- request ------------------------------------------------------------
+
+// runnerTrace returns the "trace" object for this request's llama-server
+// call, or nil when the request does not want runner events or the runner
+// is stock. A nil result leaves the request byte-identical to an untraced
+// one apart from the basic-tier fields (n_probs, timings_per_token).
+func (d *traceDecode) runnerTrace(ctx context.Context, s *llamaServerRunner) *runnerTraceRequest {
+	if d == nil || !d.tr.WantsRunnerTrace() {
+		return nil
+	}
+	if !s.probeTrace(ctx) {
+		d.tr.DisableRunnerStep()
+		return nil
+	}
+	d.native = true
+	r := &runnerTraceRequest{
+		Detail:      "layers",
+		LayerStride: max(envconfig.TraceLayerStride(), 1),
+		AttnLayers:  max(envconfig.TraceAttnLayers(), 1),
+		AttnHeads:   envconfig.TraceAttnHeads(),
+	}
+	if d.tr.Detail().String() == "full" {
+		r.Detail = "full"
+	}
+	if step := d.tr.RunnerStep(); step != "" {
+		if d.tr.HubConnected() {
+			r.Step = step
+			r.StepTimeoutMS = envconfig.TraceStepTimeout().Milliseconds()
+		} else {
+			d.tr.DisableRunnerStep()
+		}
+	}
+	return r
+}
+
+// forwardAcks passes the visualizer's step-mode acks on to llama-server's
+// POST /trace/ack until the returned stop function is called. stop sends
+// {"continue":true}, so llama-server never waits for a request that ended
+// or a client that went away; so does losing the visualizer socket.
+func (d *traceDecode) forwardAcks(s *llamaServerRunner) (stop func()) {
+	if d == nil || !d.native {
+		return func() {}
+	}
+	acks := d.tr.RunnerAcks()
+	if acks == nil {
+		return func() {}
+	}
+	post := func(cont bool) {
+		body := map[string]any{}
+		if slot := d.slot.Load(); slot >= 0 {
+			body["id_slot"] = slot
+		}
+		if cont {
+			body["continue"] = true
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		if code, err := s.postTraceAck(ctx, body); err != nil || (code != http.StatusOK && code != http.StatusConflict) {
+			slog.Debug("trace: ack to llama-server failed", "status", code, "error", err)
+		}
+	}
+	done := make(chan struct{})
+	finished := make(chan struct{})
+	go func() {
+		defer close(finished)
+		tick := time.NewTicker(250 * time.Millisecond)
+		defer tick.Stop()
+		for {
+			select {
+			case cont := <-acks:
+				post(cont)
+				if cont {
+					return
+				}
+			case <-tick.C:
+				if !d.tr.HubConnected() {
+					post(true)
+					return
+				}
+			case <-done:
+				return
+			}
+		}
+	}()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			close(done)
+			<-finished
+			post(true)
+		})
+	}
+}
+
+// ---- chunks ---------------------------------------------------------------
+
+// chunk handles one streamed llama-server chunk. tokenChunk is true when the
+// chunk carries generated text (or the EOS stop); trace-only chunks only
+// carry runner events.
+func (d *traceDecode) chunk(ctx context.Context, rt *runnerTraceChunk, t llamaServerTimings, probs []llamaServerTokenProb, tokenChunk, eos bool) {
+	if d == nil {
+		return
+	}
+	if !d.native {
+		if tokenChunk {
+			d.step(ctx, t, probs, eos)
+		}
+		return
+	}
+	d.runnerChunk(ctx, rt, t, probs, tokenChunk, eos)
+}
+
+func (d *traceDecode) runnerChunk(ctx context.Context, rt *runnerTraceChunk, t llamaServerTimings, probs []llamaServerTokenProb, tokenChunk, eos bool) {
+	if rt.TNs != nil {
+		d.observeClock(d.tr.Now(), *rt.TNs)
+	}
+	if rt.Slot != nil {
+		d.slot.Store(int32(*rt.Slot))
+	}
+	if rt.Caps != nil && !d.capsSeen {
+		d.capsSeen = true
+		if len(rt.Caps) > 0 {
+			slog.Info("llama-server trace capabilities missing", "req", d.tr.ID(), "caps", rt.Caps)
+		}
+		if slices.Contains(rt.Caps, "no_step") {
+			// Another request holds llama-server's step gate.
+			d.tr.DisableRunnerStep()
+		}
+	}
+
+	evs := make([]runnerEvent, 0, len(rt.Trace))
+	for _, raw := range rt.Trace {
+		ev, err := parseRunnerEvent(raw)
+		if err != nil {
+			slog.Debug("trace: bad llama-server event", "error", err)
+			continue
+		}
+		evs = append(evs, ev)
+	}
+	// prefill.batch events are held back until the prefill ends, so a chunk
+	// is not in time order.
+	slices.SortStableFunc(evs, func(a, b runnerEvent) int {
+		switch {
+		case a.tns < b.tns:
+			return -1
+		case a.tns > b.tns:
+			return 1
+		}
+		return 0
+	})
+
+	// Steps whose token is complete with this chunk get decode.logits and
+	// decode.sample. predicted_n counts every token sampled so far, so it
+	// also covers tokens whose text llama-server held back.
+	target := d.completed
+	if t.PredictN > 0 {
+		target = max(target, t.PredictN-1)
+	} else if tokenChunk {
+		target = max(target+1, d.tr.CurrentStep())
+	}
+
+	var stepped []runnerEvent
+	for _, ev := range evs {
+		if ev.step >= 0 {
+			stepped = append(stepped, ev)
+			continue
+		}
+		switch ev.typ {
+		case "prefill.batch":
+			d.realPrefill = true
+			var b struct {
+				To int `json:"to"`
+			}
+			if json.Unmarshal(ev.body, &b) == nil {
+				d.prefillTo = max(d.prefillTo, b.To)
+			}
+		case "prefill.done":
+			d.realPrefill = true
+		}
+		d.tr.Forward(ev.typ, ev.body, d.rebase(ev.tns))
+	}
+	if d.realPrefill && !d.prefilled {
+		d.prefilled = true
+		d.promptTotal = d.prefillTo
+		if t.PromptN > 0 || t.CacheN != nil {
+			d.promptTotal = t.promptEvalCount()
+		}
+	}
+
+	for i := 0; i < len(stepped); {
+		s := stepped[i].step
+		j := i
+		for j < len(stepped) && stepped[j].step == s {
+			j++
+		}
+		if s > d.completed {
+			d.advance(ctx, s, d.rebase(stepped[i].tns), t)
+		}
+		for _, ev := range stepped[i:j] {
+			if ev.typ == "decode.sample" {
+				if s > d.completed {
+					d.pendingSample[s] = runnerSample{body: ev.body, tns: d.rebase(ev.tns)}
+				}
+				continue
+			}
+			d.tr.Forward(ev.typ, ev.body, d.rebase(ev.tns))
+		}
+		if s <= target && s > d.completed {
+			d.complete(ctx, s, target, probs, eos, t)
+		}
+		i = j
+	}
+	for s := d.completed + 1; s <= target; s++ {
+		d.complete(ctx, s, target, probs, eos, t)
+	}
+	if eos {
+		d.tr.MarkEOS()
+	}
+}
+
+// observeClock updates the llama-server to tracer clock offset from a chunk
+// built at sent (llama-server steady clock) and received at recv (tracer
+// clock). The smallest gap seen has the least transport delay in it, so it is
+// the best estimate.
+func (d *traceDecode) observeClock(recv, sent int64) {
+	if off := recv - sent; !d.hasOffset || off < d.offset {
+		d.offset, d.hasOffset = off, true
+	}
+}
+
+// rebase converts a llama-server timestamp to the tracer clock (-1 = now
+// when no chunk has carried __trace_t_ns yet).
+func (d *traceDecode) rebase(tns int64) int64 {
+	if !d.hasOffset {
+		return -1
+	}
+	return max(tns+d.offset, 0)
+}
+
+type runnerSample struct {
+	body []byte
+	tns  int64
+}
+
+// advance starts every step up to s. The first decode.step.start of a step
+// takes the time of its first runner event.
+func (d *traceDecode) advance(ctx context.Context, s int, tns int64, t llamaServerTimings) {
+	if !d.prefilled {
+		d.prefill(t)
+	}
+	for cur := d.tr.CurrentStep() + 1; cur <= s; cur++ {
+		at := int64(-1)
+		if cur == s {
+			at = tns
+		}
+		d.tr.StepStartAt(ctx, d.promptTotal+cur, d.kvTotal, at)
+	}
+}
+
+// complete emits decode.logits and decode.sample for step s, whose token
+// arrived with this chunk. The chunk's probabilities end with its last
+// token (target), so they are matched from the end.
+func (d *traceDecode) complete(ctx context.Context, s, target int, probs []llamaServerTokenProb, eos bool, t llamaServerTimings) {
+	d.advance(ctx, s, -1, t)
+	chosen := -1
+	if i := len(probs) - 1 - (target - s); i >= 0 && i < len(probs) {
+		chosen = probs[i].ID
+		d.tr.Logits(s, traceCandidates(probs[i]))
+	} else {
+		d.tr.Logits(s, nil)
+	}
+	if ps, ok := d.pendingSample[s]; ok {
+		delete(d.pendingSample, s)
+		d.tr.Forward("decode.sample", ps.body, ps.tns)
+	} else {
+		if eos && s == target && chosen < 0 {
+			chosen = d.eosID
+		}
+		method := "dist"
+		if d.opts.Temperature <= 0 {
+			method = "greedy"
+		}
+		d.tr.Sample(s, chosen, f32(d.opts.Temperature), f32(d.opts.TopP), d.opts.TopK, method)
+	}
+	d.completed = s
+}
+
+// drainTraceLine collects the trace fields of the chunks llama-server sends after
+// the one that finished an OpenAI-compatible chat stream (the final array's
+// later chunks carry the last events).
+func drainTraceLine(line []byte, into *runnerTraceChunk) {
+	if len(line) == 0 || line[0] == ':' {
+		return
+	}
+	evt, ok := bytes.CutPrefix(line, []byte("data: "))
+	if !ok {
+		evt = line
+	}
+	if bytes.Equal(evt, []byte("[DONE]")) || !bytes.Contains(evt, []byte("__trace")) {
+		return
+	}
+	var c runnerTraceChunk
+	if err := json.Unmarshal(evt, &c); err == nil {
+		into.merge(c)
+	}
+}
