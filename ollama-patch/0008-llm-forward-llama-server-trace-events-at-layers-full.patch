+// ---- test hub: the visualizer side of the trace socket ----------------------
+
+type testHub struct {
+	srv *httptest.Server
+
+	mu     sync.Mutex
+	conn   *websocket.Conn
+	events map[string][]map[string]any
+	notify chan struct{}
+	onEv   map[string]func(ev map[string]any) // per req
+}
+
+var (
+	hubOnce sync.Once
+	hub     *testHub
+)
+
+// traceTestHub starts one hub for the test binary (the emitter is a process
+// singleton configured from OLLAMA_TRACE_URL) and waits until Ollama's side
+// is connected.
+func traceTestHub(t *testing.T) *testHub {
+	t.Helper()
+	hubOnce.Do(func() {
+		h := &testHub{events: map[string][]map[string]any{}, notify: make(chan struct{}, 1), onEv: map[string]func(map[string]any){}}
+		h.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			c, err := websocket.Accept(w, r, nil)
+			if err != nil {
+				return
+			}
+			c.SetReadLimit(64 << 20)
+			h.mu.Lock()
+			h.conn = c
+			h.mu.Unlock()
+			for {
+				_, data, err := c.Read(context.Background())
+				if err != nil {
+					return
+				}
+				for line := range bytes.SplitSeq(data, []byte("\n")) {
+					var ev map[string]any
+					if json.Unmarshal(line, &ev) != nil {
+						continue
+					}
+					req, _ := ev["req"].(string)
+					h.mu.Lock()
+					h.events[req] = append(h.events[req], ev)
+					cb := h.onEv[req]
+					h.mu.Unlock()
+					if cb != nil {
+						cb(ev)
+					}
+					select {
+					case h.notify <- struct{}{}:
+					default:
+					}
+				}
+			}
+		}))
+		os.Setenv("OLLAMA_TRACE_URL", "ws"+strings.TrimPrefix(h.srv.URL, "http")+"/ingest")
+		trace.Init()
+		hub = h
+	})
+	probe := trace.NewRequest("hub-probe", "", "")
+	for i := 0; !probe.HubConnected(); i++ {
+		if i > 500 {
+			t.Fatal("trace hub never connected")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	return hub
+}
+
+func (h *testHub) ack(req string, cont bool) {
+	h.mu.Lock()
+	c := h.conn
+	h.mu.Unlock()
+	msg := fmt.Sprintf(`{"v":1,"type":"ack","req":%q,"continue":%v}`, req, cont)
+	c.Write(context.Background(), websocket.MessageText, []byte(msg))
+}
+
+// wait returns the events of req once request.done has arrived.
+func (h *testHub) wait(t *testing.T, req string) []map[string]any {
+	t.Helper()
+	deadline := time.After(5 * time.Second)
+	for {
+		h.mu.Lock()
+		evs := h.events[req]
+		h.mu.Unlock()
+		if len(evs) > 0 && evs[len(evs)-1]["type"] == "request.done" {
+			return evs
+		}
+		select {
+		case <-h.notify:
+		case <-time.After(10 * time.Millisecond):
+		case <-deadline:
+			t.Fatalf("no request.done for %s; got %d events", req, len(evs))
+		}
+	}
+}
+
+// ---- fake llama-server ------------------------------------------------------
+
+type fakeLlamaServer struct {
+	t       *testing.T
+	patched bool
+	stream  func(w io.Writer, flush func(), acks <-chan map[string]any)
+
+	mu      sync.Mutex
+	body    []byte // last completion request body
+	acks    []map[string]any
+	ackCh   chan map[string]any
+	probeOK bool
+}
+
+func newFakeLlamaServer(t *testing.T, patched bool, stream func(w io.Writer, flush func(), acks <-chan map[string]any)) (*fakeLlamaServer, *llamaServerRunner) {
+	f := &fakeLlamaServer{t: t, patched: patched, stream: stream, ackCh: make(chan map[string]any, 64)}
+	srv := httptest.NewServer(f)
+	t.Cleanup(srv.Close)
+	var port int
+	fmt.Sscanf(srv.URL[strings.LastIndex(srv.URL, ":")+1:], "%d", &port)
+	return f, &llamaServerRunner{
+		port:    port,
+		cmd:     fakeRunningCmd(),
+		sem:     semaphore.NewWeighted(1),
+		options: api.Options{Runner: api.Runner{NumCtx: 2048}},
+	}
+}
+
+func (f *fakeLlamaServer) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	switch r.URL.Path {
+	case "/health":
+		fmt.Fprint(w, `{"status":"ok"}`)
+	case "/tokenize":
+		fmt.Fprint(w, `{"tokens":[{"id":1,"piece":"Hi"}]}`)
+	case "/apply-template":
+		fmt.Fprint(w, `{"prompt":"rendered"}`)
+	case "/trace/ack":
+		if !f.patched {
+			http.NotFound(w, r)
+			return
+		}
+		var body map[string]any
+		json.NewDecoder(r.Body).Decode(&body)
+		if body["id_slot"] == float64(2147483647) {
+			w.WriteHeader(http.StatusConflict)
+			fmt.Fprint(w, `{"ok":false,"error":"no request in step mode"}`)
+			return
+		}
+		f.mu.Lock()
+		f.acks = append(f.acks, body)
+		f.mu.Unlock()
+		f.ackCh <- body
+		fmt.Fprint(w, `{"ok":true}`)
+	case "/completion", "/v1/chat/completions":
+		body, _ := io.ReadAll(r.Body)
+		f.mu.Lock()
+		f.body = body
+		f.mu.Unlock()
+		w.Header().Set("Content-Type", "text/event-stream")
+		fl, _ := w.(http.Flusher)
+		f.stream(w, func() { fl.Flush() }, f.ackCh)
+	default:
+		f.t.Errorf("unexpected path %s", r.URL.Path)
+	}
+}
+
+func (f *fakeLlamaServer) traceField() map[string]any {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	var req map[string]any
+	if err := json.Unmarshal(f.body, &req); err != nil {
+		f.t.Fatalf("bad request body %s", f.body)
+	}
+	tr, _ := req["trace"].(map[string]any)
+	return tr
+}
+
+func sse(w io.Writer, flush func(), chunks ...string) {
+	for _, c := range chunks {
+		fmt.Fprintf(w, "data: %s\n\n", c)
+	}
+	flush()
+}
+
+// tracedCompletion runs a /completion request through runner with a tracer
+// in the context, emitting decode.token like server/ does.
+func tracedCompletion(t *testing.T, r *llamaServerRunner, req, detail, step string) []map[string]any {
+	t.Helper()
+	tr := trace.NewRequest(req, detail, step)
+	tr.SetRunnerPatched(true)
+	tr.Received("m", 2, nil)
+	ctx := trace.NewContext(t.Context(), tr)
+	opts := api.DefaultOptions()
+	opts.Temperature = 0.8
+	err := r.Completion(ctx, CompletionRequest{Prompt: "Hi", Options: &opts}, func(cr CompletionResponse) {
+		tr.Token(ctx, cr.Content, cr.Done)
+	})
+	if err != nil {
+		t.Fatalf("Completion: %v", err)
+	}
+	tr.End(true, "")
+	return hub.wait(t, req)
+}
+
+func countTypes(evs []map[string]any) map[string]int {
+	c := map[string]int{}
+	for _, e := range evs {
+		c[e["type"].(string)]++
+	}
+	return c
+}
+
+func checkEnvelope(t *testing.T, evs []map[string]any) {
+	t.Helper()
+	var lastT float64
+	for i, e := range evs {
+		if e["seq"] != float64(i) {
+			t.Fatalf("event %d has seq %v", i, e["seq"])
+		}
+		tns := e["t_ns"].(float64)
+		if tns < lastT {
+			t.Fatalf("t_ns goes backwards at seq %d (%s)", i, e["type"])
+		}
+		lastT = tns
+		if e["v"] != float64(1) {
+			t.Fatalf("event %d without v:1", i)
+		}
+	}
+}
+
+// ---- tests ------------------------------------------------------------------
+
+func TestParseRunnerEvent(t *testing.T) {
+	ev, err := parseRunnerEvent(json.RawMessage(`{"type":"decode.layer","t_ns":123456789012,"step":2,"layer":3,"ms":1.5,"device":"CUDA0"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ev.typ != "decode.layer" || ev.tns != 123456789012 || ev.step != 1 {
+		t.Fatalf("got %+v", ev)
+	}
+	var body map[string]any
+	json.Unmarshal(ev.body, &body)
+	if _, ok := body["type"]; ok {
+		t.Error("type left in body")
+	}
+	if _, ok := body["t_ns"]; ok {
+		t.Error("t_ns left in body")
+	}
+	if body["step"] != float64(1) || body["layer"] != float64(3) || body["device"] != "CUDA0" {
+		t.Errorf("body = %s", ev.body)
+	}
+
+	ev, err = parseRunnerEvent(json.RawMessage(`{"type":"prefill.batch","t_ns":5,"batch_i":0,"of":1,"from":0,"to":4,"ms":2}`))
+	if err != nil || ev.step != -1 {
+		t.Fatalf("prefill: %+v %v", ev, err)
+	}
+	if _, err := parseRunnerEvent(json.RawMessage(`{"t_ns":5}`)); err == nil {
+		t.Error("event without type accepted")
+	}
+}
+
+func TestRunnerTraceClockOffset(t *testing.T) {
+	d := &traceDecode{}
+	if got := d.rebase(10); got != -1 {
+		t.Fatalf("rebase before any chunk = %d, want -1 (now)", got)
+	}
+	d.observeClock(5_000, 1_000) // offset 4000
+	if got := d.rebase(900); got != 4_900 {
+		t.Fatalf("rebase = %d, want 4900", got)
+	}
+	d.observeClock(9_000, 2_000) // offset 7000: slower delivery, ignored
+	if got := d.rebase(900); got != 4_900 {
+		t.Fatalf("larger offset replaced the smaller one: %d", got)
+	}
+	d.observeClock(9_500, 6_000) // offset 3500: kept
+	if got := d.rebase(900); got != 4_400 {
+		t.Fatalf("rebase = %d, want 4400", got)
+	}
+}
