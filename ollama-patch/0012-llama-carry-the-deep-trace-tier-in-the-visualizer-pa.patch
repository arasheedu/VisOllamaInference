++// [visualizer-trace] logit lens: rows -> final norm -> output head, on the backend that holds the head.
++// Mirrors the llama-family tail (build_norm(output_norm[, output_norm_b]) + build_lora_mm(output, output_s)
++// + output_b); LoRA adapters, Hadamard-folded heads and arch-specific logit scaling are not applied.
++int32_t llama_context::trace_logit_lens(const float * rows, int32_t n_rows, float * logits) {
++    const auto & hp = model.hparams;
++
++    ggml_tensor * w  = model.output;
++    ggml_tensor * nw = model.output_norm;
++    if (!w || !nw || !w->buffer || !nw->buffer || w->ne[0] != (int64_t) hp.n_embd || nw->ne[0] != w->ne[0]) {
++        return -1;
++    }
++
++    if (!trace_lens_backend) {
++        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(w->buffer);
++        for (auto & b : backends) {
++            if (ggml_backend_supports_buft(b.get(), buft)) {
++                trace_lens_backend = b.get();
++                break;
++            }
++        }
++        if (!trace_lens_backend) {
++            return -1;
++        }
++        trace_lens_galloc.reset(ggml_gallocr_new(ggml_backend_get_default_buffer_type(trace_lens_backend)));
++    }
++    if (n_rows <= 0) {
++        return 0;
++    }
++
++    if (n_rows != trace_lens_rows || !trace_lens_gf) {
++        const size_t n_nodes = 16;
++        ggml_init_params ip = {
++            /*.mem_size   =*/ ggml_tensor_overhead()*n_nodes + ggml_graph_overhead_custom(n_nodes, false),
++            /*.mem_buffer =*/ nullptr,
++            /*.no_alloc   =*/ true,
++        };
++        trace_lens_ctx.reset(ggml_init(ip));
++        ggml_context * c = trace_lens_ctx.get();
++
++        ggml_tensor * inp = ggml_new_tensor_2d(c, GGML_TYPE_F32, w->ne[0], n_rows);
++        ggml_set_input(inp);
++
++        ggml_tensor * cur = model.output_norm_b ? ggml_norm(c, inp, hp.f_norm_eps) : ggml_rms_norm(c, inp, hp.f_norm_rms_eps);
++        cur = ggml_mul(c, cur, nw);
++        if (model.output_norm_b) {
++            cur = ggml_add(c, cur, model.output_norm_b);
++        }
++        cur = ggml_mul_mat(c, w, cur);
++        if (model.output_s) {
++            cur = ggml_mul(c, cur, model.output_s);
++        }
++        if (model.output_b) {
++            cur = ggml_add(c, cur, model.output_b);
++        }
++        ggml_set_output(cur);
++
++        ggml_cgraph * gf = ggml_new_graph_custom(c, n_nodes, false);
++        ggml_build_forward_expand(gf, cur);
++        if (!ggml_gallocr_alloc_graph(trace_lens_galloc.get(), gf)) {
++            trace_lens_gf = nullptr;
++            return -2;
++        }
++        trace_lens_gf   = gf;
++        trace_lens_inp  = inp;
++        trace_lens_out  = cur;
++        trace_lens_rows = n_rows;
++    }
++
++    ggml_backend_tensor_set(trace_lens_inp, rows, 0, ggml_nbytes(trace_lens_inp));
++    if (ggml_backend_graph_compute(trace_lens_backend, trace_lens_gf) != GGML_STATUS_SUCCESS) {
++        return -2;
++    }
++    ggml_backend_tensor_get(trace_lens_out, logits, 0, ggml_nbytes(trace_lens_out));
++    return 0;
++}
