+// At deep detail the runner gets detail "full" with deep: true, and the deep
+// events are forwarded with Ollama's step numbering; at full they are dropped.
+func TestRunnerTraceDeep(t *testing.T) {
+	traceTestHub(t)
+	stream := func(w io.Writer, flush func(), _ <-chan map[string]any) {
+		sse(w, flush,
+			`{"content":"A","stop":false,"timings":{"predicted_n":1},"__trace_t_ns":100,"__trace_caps":[],"__trace_slot":0,"__trace":[{"type":"prefill.done","t_ns":10,"n_tokens":1,"ms":1},{"type":"decode.sample","t_ns":20,"step":1,"chosen_id":1,"temp":0.8,"top_p":0.9,"top_k":40,"method":"dist"}]}`,
+			`{"content":"B","stop":false,"timings":{"predicted_n":2},"__trace_t_ns":200,"__trace":[`+
+				`{"type":"decode.node","t_ns":140,"step":2,"layer":0,"i":0,"name":"norm","op":"RMS_NORM","shape":[3072],"ms":0.01,"stats":{"min":-1,"max":1,"mean":0,"rms":0.5}},`+
+				`{"type":"decode.attn.heads","t_ns":145,"step":2,"layer":0,"from":0,"n_kv_head":1,"rows":[[0.9,0.1]]},`+
+				`{"type":"decode.layer","t_ns":150,"step":2,"layer":0,"ms":0.5},`+
+				`{"type":"decode.lens","t_ns":155,"step":2,"layer":0,"top":[{"id":2,"p":0.5,"text":"B"}],"entropy":1.2},`+
+				`{"type":"decode.sample","t_ns":160,"step":2,"chosen_id":2,"temp":0.8,"top_p":0.9,"top_k":40,"method":"dist"}]}`,
+			`{"content":"","stop":true,"stop_type":"limit","timings":{"predicted_n":2}}`,
+		)
+	}
+
+	f, r := newFakeLlamaServer(t, true, stream)
+	evs := tracedCompletion(t, r, "rt-deep", "deep", "")
+	checkEnvelope(t, evs)
+	if tr := f.traceField(); tr == nil || tr["detail"] != "full" || tr["deep"] != true {
+		t.Fatalf("trace request = %v", tr)
+	}
+	c := countTypes(evs)
+	if c["decode.node"] != 1 || c["decode.lens"] != 1 || c["decode.attn.heads"] != 1 || c["decode.layer"] != 1 {
+		t.Errorf("counts %v", c)
+	}
+	for _, e := range evs {
+		switch e["type"] {
+		case "decode.node", "decode.lens", "decode.attn.heads":
+			if e["step"] != float64(1) {
+				t.Errorf("%s step %v, want 1 (llama-server step 2)", e["type"], e["step"])
+			}
+		case "request.received":
+			if e["detail"] != "deep" {
+				t.Errorf("request.received detail = %v", e["detail"])
+			}
+		}
+	}
+
+	f, r = newFakeLlamaServer(t, true, stream)
+	evs = tracedCompletion(t, r, "rt-deep-full", "full", "")
+	if tr := f.traceField(); tr == nil || tr["detail"] != "full" || tr["deep"] != nil {
+		t.Fatalf("trace request at full = %v", tr)
+	}
+	c = countTypes(evs)
+	if c["decode.node"]+c["decode.lens"]+c["decode.attn.heads"] != 0 || c["decode.layer"] != 1 {
+		t.Errorf("counts at full %v", c)
+	}
+}
