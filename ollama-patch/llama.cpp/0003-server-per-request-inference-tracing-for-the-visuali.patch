new file mode 100644
index 000000000..484113f7c
--- /dev/null
+++ b/tools/server/server-trace.h
@@ -0,0 +1,143 @@
+// [visualizer-trace] per-request inference tracing for llama-server
+//
+// A request opts in with a "trace" object (see server_trace_params). The collector observes the
+// forward pass through the scheduler eval callback, snapshots the sampler chain, and hands the
+// collected events to the response chunk that carries the token they belong to ("__trace").
+// No "trace" field: no callback is installed and every hook is a single branch.
+//
+// Contract and limitations: ollama-patch/llama.cpp/README.md in the visualizer repository.
+
+#pragma once
+
+#include "server-common.h"
+
+#include "llama.h"
+#include "sampling.h"
+
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <vector>
+
+enum server_trace_detail {
+    SERVER_TRACE_OFF = 0,
+    SERVER_TRACE_LAYERS,
+    SERVER_TRACE_FULL,
+};
+
+enum server_trace_step {
+    SERVER_TRACE_STEP_NONE = 0,
+    SERVER_TRACE_STEP_LAYER,
+    SERVER_TRACE_STEP_SAMPLE,
+};
+
+struct server_trace_params {
+    server_trace_detail detail = SERVER_TRACE_OFF;
+
+    int32_t layer_stride    = 4;     // decode.layer etc. on every step < 8, then every layer_stride-th step
+    int32_t attn_layers     = 4;     // decode.attn on every attn_layers-th layer
+    int32_t attn_topk       = 8;     // positions per decode.attn event
+    bool    attn_heads      = false; // also emit one decode.attn per head
+    int32_t sample_topn     = 64;    // candidates per decode.sample.stage
+    server_trace_step step  = SERVER_TRACE_STEP_NONE;
+    int32_t step_timeout_ms = 60000;
+
+    bool enabled() const { return detail != SERVER_TRACE_OFF; }
+
+    // throws std::invalid_argument on a malformed object; null -> disabled
+    static server_trace_params from_json(const json & j);
+};
+
+// trace data attached to one response chunk
+struct server_trace_payload {
+    json    events;          // array, or null when there is nothing to send
+    json    caps;            // array, set on the first chunk only
+    int32_t id_slot = -1;    // set on the first chunk only
+    int64_t t_ns    = 0;     // steady_clock ns when the payload was taken
+
+    bool empty() const { return events.is_null() && caps.is_null(); }
+
+    // adds __trace / __trace_caps / __trace_slot / __trace_t_ns to a chunk object; for an array of
+    // chunks (OAI chat stream) to the last one, appending a choice-less chunk if the array is empty
+    void attach(json & res) const;
+};
+
+struct server_trace {
+    server_trace_params p;
+
+    // request lifecycle (main thread)
+    void start(const server_trace_params & params, int32_t id_slot, llama_context * ctx, std::function<void()> flush_fn);
+    void stop();
+    bool active() const { return p.enabled(); }
+
+    // hooks, see server-context.cpp
+    void before_decode(llama_context * ctx, bool prefill, int32_t step, int32_t pos_first, int32_t pos_last, int32_t n_tokens);
+    void after_decode (llama_context * ctx);
+    void prefill_done();
+    void sample_begin(common_sampler * smpl, int32_t step);
+    void sample_end  (common_sampler * smpl, llama_token id, const common_params_sampling & sparams);
+
+    server_trace_payload take();
+
+    // ggml_backend_sched_eval_callback
+    static bool eval_cb(struct ggml_tensor * t, bool ask, void * user_data);
+    // common_sampler_stage_cb
+    static void stage_cb(struct llama_sampler * smpl, const char * stage, const llama_token_data_array * cur_p, bool pre, void * user_data);
+
+private:
+    enum attn_kind { ATTN_NONE, ATTN_SOFTMAX, ATTN_FLASH };
+
+    // events/caps_sent are only touched on the slot-loop thread (the eval callback runs there too,
+    // inside queue_tasks.yield_to_queue()), so no lock is needed
+    json events = json::array();
+    bool caps_sent = false;
+
+    std::function<void()> flush_fn; // sends a trace-only chunk (stream + step mode)
+    int32_t id_slot  = -1;
+    int32_t n_layer  = 0;
+    bool    step_own = false; // holds the global step gate
+    bool    step_busy = false; // step mode requested, but another request holds the gate
+    bool    no_stages = false; // backend sampling: no CPU chain to observe
+    attn_kind attn = ATTN_NONE;
+
+    // current pass
+    bool    prefill  = false;
+    bool    observe  = false;
+    int32_t step     = 0;
+    int32_t pos      = 0;   // decode: position of the input token
+    int32_t cur_layer = -1; // last layer index seen in the ask phase
+    bool    in_ub    = false;
+    int64_t t_last   = 0;   // last observation
+    int64_t t_layer  = 0;   // start of the current layer
+    int64_t t_ub     = 0;   // start of the current ubatch
+    double  ops[7]   = {};  // per-op ms in the current layer
+
+    // prefill
+    int32_t ub_i       = -1;
+    int32_t ub_ntok    = 0;
+    int32_t pass_from  = 0; // pos of the next ubatch's first token
+    int32_t prefill_n  = 0;
+    int64_t t_prefill  = 0;
+    std::vector<json> prefill_batches; // held until prefill_done() to fill in "of"
+
+    // decode full detail
+    std::vector<float> row_prev, row_cur; // residual stream rows
+    std::vector<int32_t> moe_ids;
+    std::vector<float>   moe_w;
+
+    // sampling
+    int32_t sample_step = 0;
+    double  draw = -1.0;
+
+    void emit(json && ev);
+    bool want(const struct ggml_tensor * t, const char * base, int il) const;
+    void on_observed(struct ggml_tensor * t, const char * base, int il);
+    void attn_softmax(struct ggml_tensor * t, int il);
+    void attn_flash  (struct ggml_tensor * t, int il);
+    void attn_emit(int il, const std::vector<float> & w_avg, const std::vector<std::vector<float>> & w_heads);
+    void wait_step(const char * granularity);
+};
+
+// POST /trace/ack body -> response body
+json server_trace_ack(const json & body);
