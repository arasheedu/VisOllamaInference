From 87094036ac668f43ebcd6f780aa3c907975f31c1 Mon Sep 17 00:00:00 2001
From: Rasheed <arasheedu@gmail.com>
Date: Thu, 29 Oct 2026 15:08:43 -0700
Subject: [PATCH 1/6] llama: add llama_set_eval_callback to install the eval
 callback at runtime

[visualizer-trace] lets llama-server enable the scheduler eval callback only
for batches that belong to a traced request.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 include/llama.h       |  5 +++++
 src/llama-context.cpp | 13 +++++++++++++
 src/llama-context.h   |  1 +
 3 files changed, 19 insertions(+)

diff --git a/include/llama.h b/include/llama.h
index ae54e661b..0ab421b1d 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -1127,6 +1127,11 @@ extern "C" {
     // Set abort callback
     LLAMA_API void llama_set_abort_callback(struct llama_context * ctx, ggml_abort_callback abort_callback, void * abort_callback_data);
 
+    // [visualizer-trace] Install (or remove, with cb_eval == NULL) the scheduler eval callback at runtime,
+    // overriding llama_context_params.cb_eval. Takes effect on the next graph compute, including reused
+    // graphs. With no callback installed the scheduler computes each split in a single call.
+    LLAMA_API void llama_set_eval_callback(struct llama_context * ctx, ggml_backend_sched_eval_callback cb_eval, void * cb_eval_user_data);
+
     // Wait until all computations are finished
     // This is automatically done when using one of the functions below to obtain the computation results
     // and is not necessary to call it explicitly in most cases
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 33ad7845f..5bff79db0 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1320,6 +1320,15 @@ void llama_context::set_n_threads(int32_t n_threads, int32_t n_threads_batch) {
     cparams.n_threads_batch = n_threads_batch;
 }
 
+// [visualizer-trace] runtime eval callback. process_ubatch() re-applies cparams.cb_eval whenever it
+// rebuilds a graph, and the scheduler keeps the callback across reused graphs, so set both.
+void llama_context::set_eval_callback(ggml_backend_sched_eval_callback cb_eval, void * cb_eval_user_data) {
+    cparams.cb_eval           = cb_eval;
+    cparams.cb_eval_user_data = cb_eval_user_data;
+
+    ggml_backend_sched_set_eval_callback(sched.get(), cb_eval, cb_eval_user_data);
+}
+
 void llama_context::set_abort_callback(bool (*abort_callback)(void * data), void * abort_callback_data) {
     LLAMA_LOG_DEBUG("%s: call\n", __func__);
 
@@ -4218,6 +4227,10 @@ void llama_set_abort_callback(llama_context * ctx, bool (*abort_callback)(void *
     ctx->set_abort_callback(abort_callback, abort_callback_data);
 }
 
+void llama_set_eval_callback(llama_context * ctx, ggml_backend_sched_eval_callback cb_eval, void * cb_eval_user_data) {
+    ctx->set_eval_callback(cb_eval, cb_eval_user_data);
+}
+
 void llama_set_embeddings(llama_context * ctx, bool embeddings) {
     ctx->set_embeddings(embeddings);
 }
diff --git a/src/llama-context.h b/src/llama-context.h
index 6938fb103..988f5e95a 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -116,6 +116,7 @@ struct llama_context {
     void set_n_threads(int32_t n_threads, int32_t n_threads_batch);
 
     void set_abort_callback(bool (*abort_callback)(void * data), void * abort_callback_data);
+    void set_eval_callback(ggml_backend_sched_eval_callback cb_eval, void * cb_eval_user_data); // [visualizer-trace]
 
     void set_embeddings (bool value);
     void set_embeddings_nextn(bool value, bool masked);
-- 
