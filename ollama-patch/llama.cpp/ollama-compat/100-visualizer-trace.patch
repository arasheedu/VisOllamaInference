+// [visualizer-trace] see server-trace.h
+
+#include "server-trace.h"
+
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstring>
+#include <queue>
+#include <stdexcept>
