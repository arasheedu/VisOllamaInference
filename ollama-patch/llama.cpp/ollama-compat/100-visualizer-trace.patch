+//
+// helpers
+//
+
+static int64_t trace_now_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+static double ns_to_ms(int64_t ns) {
+    return ns > 0 ? std::round((double) ns / 1e2) / 1e4 : 0.0; // ms, 0.1 us resolution
+}
+
+static json trace_ev(const char * type) {
+    return json{{"type", type}, {"t_ns", trace_now_ns()}};
+}
+
+// "Qcur-12" -> base "Qcur", il 12. Names with any other suffix (views such as "Qcur-12 (reshaped)",
+// scheduler copies such as "CUDA0#Qcur-12#0") return false. Names without "-<il>" give il = -1.
+static bool trace_parse_name(const char * name, char * base, size_t base_size, int & il) {
+    if (strchr(name, '#') || strchr(name, ' ')) {
+        return false;
+    }
+    const char * dash = strrchr(name, '-');
+    il = -1;
+    size_t n = strlen(name);
+    if (dash && dash[1] != '\0') {
+        bool digits = true;
+        for (const char * c = dash + 1; *c; ++c) {
+            digits &= (*c >= '0' && *c <= '9');
+        }
+        if (digits) {
+            il = atoi(dash + 1);
+            n  = (size_t) (dash - name);
+        }
+    }
+    if (n + 1 > base_size) {
+        return false;
+    }
+    memcpy(base, name, n);
+    base[n] = '\0';
+    return true;
+}
+
+// op enum of the trace schema; the segment of the graph that ends at a node is charged to its op
+enum { OP_NORM, OP_QKV, OP_SCORES, OP_ATTN_OUT, OP_MLP_UP, OP_MLP_ACT, OP_MLP_DOWN, OP_COUNT };
+static const char * OP_NAMES[OP_COUNT] = { "norm", "attn_qkv", "attn_scores", "attn_out", "mlp_up", "mlp_act", "mlp_down" };
+
+static int trace_op_of(const ggml_tensor * t, const char * b) {
+    if (t->op == GGML_OP_FLASH_ATTN_EXT) {
+        return OP_SCORES;
+    }
+    static const struct { const char * name; int op; } map[] = {
+        { "attn_norm",       OP_NORM     }, { "ffn_norm",        OP_NORM     },
+        { "Qcur",            OP_QKV      }, { "Kcur",            OP_QKV      }, { "Vcur", OP_QKV },
+        { "kq_soft_max",     OP_SCORES   },
+        { "kqv_out",         OP_ATTN_OUT }, { "attn_out",        OP_ATTN_OUT }, // attn_out: output projection (wo)
+        { "ffn_up",          OP_MLP_UP   }, { "ffn_gate",        OP_MLP_UP   },
+        { "ffn_moe_up",      OP_MLP_UP   }, { "ffn_moe_gate",    OP_MLP_UP   }, { "ffn_moe_gate_up", OP_MLP_UP },
+        { "ffn_silu",        OP_MLP_ACT  }, { "ffn_gelu",        OP_MLP_ACT  }, { "ffn_swiglu",  OP_MLP_ACT },
+        { "ffn_geglu",       OP_MLP_ACT  }, { "ffn_act",         OP_MLP_ACT  }, { "ffn_relu",    OP_MLP_ACT },
+        { "ffn_reglu",       OP_MLP_ACT  }, { "ffn_gelu_erf",    OP_MLP_ACT  }, { "ffn_geglu_erf", OP_MLP_ACT },
+        { "ffn_moe_silu",    OP_MLP_ACT  }, { "ffn_moe_swiglu",  OP_MLP_ACT  }, { "ffn_moe_gelu", OP_MLP_ACT },
+        { "ffn_moe_geglu",   OP_MLP_ACT  },
+        { "ffn_down",        OP_MLP_DOWN }, { "ffn_moe_down",    OP_MLP_DOWN },
+        { "ffn_out",         OP_MLP_DOWN }, // models rename the ffn_down output to ffn_out (and the residual add too)
+    };
+    for (const auto & m : map) {
+        if (strcmp(b, m.name) == 0) {
+            return m.op;
+        }
+    }
+    return -1;
+}
+
+static bool trace_is_moe_weights(const char * b) {
+    return strcmp(b, "ffn_moe_weights") == 0 || strcmp(b, "ffn_moe_weights_softmax") == 0 ||
+           strcmp(b, "ffn_moe_weights_norm") == 0 || strcmp(b, "ffn_moe_weights_scaled") == 0;
+}
+
+static const char * trace_device(const ggml_tensor * t) {
+    ggml_backend_buffer_t buf = t->view_src ? t->view_src->buffer : t->buffer;
+    if (!buf) {
+        return "CPU";
+    }
+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buf));
+    return dev ? ggml_backend_dev_name(dev) : "CPU";
+}
+
+// row i1 (dim 1) of a tensor with contiguous rows, converted to f32; host = the whole tensor span
+// already copied with trace_read_all() (one transfer for many rows), or nullptr to read the row
+static bool trace_read_row(const ggml_tensor * t, int64_t i1, int64_t i2, std::vector<float> & out, const uint8_t * host = nullptr) {
+    const int64_t n = t->ne[0];
+    const size_t  rs = ggml_row_size(t->type, n);
+    const size_t  off = i1*t->nb[1] + i2*t->nb[2];
+    if (t->nb[0] != ggml_type_size(t->type) || off + rs > ggml_nbytes(t)) {
+        return false;
+    }
+    out.resize(n);
+    const auto * tt = ggml_get_type_traits(t->type);
+    if (t->type != GGML_TYPE_F32 && !tt->to_float) {
+        return false;
+    }
+    std::vector<uint8_t> tmp;
+    const uint8_t * src = host ? host + off : nullptr;
+    if (!src) {
+        tmp.resize(rs);
+        ggml_backend_tensor_get(t, tmp.data(), off, rs);
+        src = tmp.data();
+    }
+    if (t->type == GGML_TYPE_F32) {
+        memcpy(out.data(), src, rs);
+    } else {
+        tt->to_float(src, out.data(), n);
+    }
+    return true;
+}
+
+static void trace_read_all(const ggml_tensor * t, std::vector<uint8_t> & buf) {
+    buf.resize(ggml_nbytes(t));
+    ggml_backend_tensor_get(t, buf.data(), 0, buf.size());
+}
+
+// no-op view nodes: observing them only adds a sync, their (zero) time merges into the next segment
+static bool trace_is_view(const ggml_tensor * t) {
+    return t->op == GGML_OP_VIEW || t->op == GGML_OP_RESHAPE || t->op == GGML_OP_PERMUTE || t->op == GGML_OP_TRANSPOSE;
+}
+
+static float trace_l2(const float * a, const float * b, size_t n) {
+    double s = 0.0;
+    for (size_t i = 0; i < n; ++i) {
+        const double d = b ? (double) a[i] - b[i] : (double) a[i];
+        s += d*d;
+    }
+    return (float) std::sqrt(s);
+}
+
+// top-n candidates by value (logit, or p after the distribution sampler); skips -inf
+static json trace_top_candidates(const llama_token_data_array * cur_p, int n, bool use_p, int32_t & n_alive) {
+    n_alive = 0;
+    auto val = [&](const llama_token_data & d) { return use_p ? d.p : d.logit; };
+    using item = std::pair<float, int32_t>; // value, index
+    std::priority_queue<item, std::vector<item>, std::greater<item>> heap; // min-heap of the best n
+    // hot loop over the full vocab for the raw stage: keep the admission threshold in a local
+    float thr = -INFINITY;
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        const float v = val(cur_p->data[i]);
+        if (v == -INFINITY) {
+            continue;
+        }
+        n_alive++;
+        if ((int) heap.size() < n) {
+            heap.push({ v, (int32_t) i });
+            if ((int) heap.size() == n) {
+                thr = heap.top().first;
+            }
+        } else if (v > thr && n > 0) {
+            heap.pop();
+            heap.push({ v, (int32_t) i });
+            thr = heap.top().first;
+        }
+    }
+    std::vector<item> best;
+    best.reserve(heap.size());
+    while (!heap.empty()) {
+        best.push_back(heap.top());
+        heap.pop();
+    }
+    json res = json::array();
+    for (auto it = best.rbegin(); it != best.rend(); ++it) {
+        res.push_back({ { "id", cur_p->data[it->second].id }, { "v", it->first } });
+    }
+    return res;
+}
+
+// llama.cpp sampler name -> trace stage name (schema SAMPLE_STAGES, else the llama.cpp name with '-' -> '_')
+static std::string trace_stage_name(const char * name) {
+    while (*name == '+' || *name == '-') {
+        name++; // backend sampler prefix, see llama_sampler_backend::get_name()
+    }
+    static const struct { const char * from; const char * to; } map[] = {
+        { "penalties", "rep_penalty" }, { "temp",  "temperature" }, { "temp-ext", "temperature" },
+        { "top-k",     "top_k"       }, { "top-p", "top_p"       }, { "min-p",    "min_p"       },
+        { "typical",   "typical_p"   }, { "top-n-sigma", "top_n_sigma" },
+    };
+    for (const auto & m : map) {
+        if (strcmp(name, m.from) == 0) {
+            return m.to;
+        }
+    }
+    std::string s = name;
+    std::replace(s.begin(), s.end(), '-', '_');
+    return s;
+}
+
+//
+// step gate: one request in step mode at a time, acked through POST /trace/ack
+//
+
+static struct {
+    std::mutex              m;
+    std::condition_variable cv;
+    int32_t     owner   = -1;  // slot id in step mode
+    int64_t     acks    = 0;   // pending acks (semaphore: an early ack is not lost)
+    bool        cont    = false;
+    bool        waiting = false;
+    std::string at_granularity;
+    int32_t     at_step  = 0;
+    int32_t     at_layer = -1;
+    std::string at_stage;
+} g_step;
+
+json server_trace_ack(const json & body) {
+    const int32_t id_slot = json_value(body, "id_slot", -1);
+    const bool    cont    = json_value(body, "continue", false);
+
+    std::unique_lock<std::mutex> lock(g_step.m);
+    if (g_step.owner < 0) {
+        return json{{"ok", false}, {"error", "no request in step mode"}};
+    }
+    if (id_slot >= 0 && id_slot != g_step.owner) {
+        return json{{"ok", false}, {"error", "slot is not in step mode"}, {"id_slot", g_step.owner}};
+    }
+    json res = {
+        {"ok", true},
+        {"id_slot", g_step.owner},
+        {"waiting", g_step.waiting},
+    };
+    if (g_step.waiting) {
+        res["at"] = json{{"granularity", g_step.at_granularity}, {"step", g_step.at_step}};
+        if (g_step.at_layer >= 0) {
+            res["at"]["layer"] = g_step.at_layer;
+        }
+        if (!g_step.at_stage.empty()) {
+            res["at"]["stage"] = g_step.at_stage;
+        }
+    }
+    if (cont) {
+        g_step.cont = true;
+    } else {
+        g_step.acks++;
+    }
+    lock.unlock();
+    g_step.cv.notify_all();
+    return res;
+}
+
+//
+// params / payload
+//
+
+server_trace_params server_trace_params::from_json(const json & j) {
+    server_trace_params p;
+    if (j.is_null()) {
+        return p;
+    }
+    if (!j.is_object()) {
+        throw std::invalid_argument("must be an object");
+    }
+    const std::string detail = json_value(j, "detail", std::string("layers"));
+    if      (detail == "layers") p.detail = SERVER_TRACE_LAYERS;
+    else if (detail == "full")   p.detail = SERVER_TRACE_FULL;
+    else if (detail == "off" || detail == "basic") p.detail = SERVER_TRACE_OFF;
+    else throw std::invalid_argument("detail must be \"layers\" or \"full\"");
+
+    p.layer_stride    = std::max(1, json_value(j, "layer_stride",    p.layer_stride));
+    p.attn_layers     = std::max(1, json_value(j, "attn_layers",     p.attn_layers));
+    p.attn_topk       = std::clamp(json_value(j, "attn_topk",        p.attn_topk),   1, 256);
+    p.attn_heads      =             json_value(j, "attn_heads",      p.attn_heads);
+    p.sample_topn     = std::clamp(json_value(j, "sample_topn",      p.sample_topn), 1, 1024);
+    p.step_timeout_ms = std::max(0, json_value(j, "step_timeout_ms", p.step_timeout_ms));
+
+    const std::string step = (j.contains("step") && j.at("step").is_string()) ? j.at("step").get<std::string>() : "";
+    if      (step.empty())     p.step = SERVER_TRACE_STEP_NONE;
+    else if (step == "layer")  p.step = SERVER_TRACE_STEP_LAYER;
+    else if (step == "sample") p.step = SERVER_TRACE_STEP_SAMPLE;
+    else if (step == "token")  p.step = SERVER_TRACE_STEP_NONE; // token granularity is handled by the client
+    else throw std::invalid_argument("step must be null, \"layer\" or \"sample\"");
+
+    p.deep        =             json_value(j, "deep",        p.deep);
+    p.lens_topk   = std::clamp(json_value(j, "lens_topk",   p.lens_topk),   1, 100);
+    p.attn_window = std::clamp(json_value(j, "attn_window", p.attn_window), 1, 1 << 20);
+    if (p.deep && p.detail != SERVER_TRACE_FULL) {
+        throw std::invalid_argument("deep requires detail \"full\"");
+    }
+    return p;
+}
+
+void server_trace_payload::attach(json & res) const {
+    if (empty()) {
+        return;
+    }
+    json * dst = &res;
+    if (res.is_array()) {
+        if (res.empty()) {
+            res.push_back(json{{"object", "chat.completion.chunk"}, {"choices", json::array()}});
+        }
+        dst = &res.back();
+    }
+    if (!dst->is_object()) {
+        return;
+    }
+    (*dst)["__trace"]      = events.is_null() ? json::array() : events;
+    (*dst)["__trace_t_ns"] = t_ns;
+    if (!caps.is_null()) {
+        (*dst)["__trace_caps"] = caps;
+        (*dst)["__trace_slot"] = id_slot;
+    }
+}
+
+//
+// lifecycle
+//
+
+static server_trace * g_installed = nullptr; // collector the eval callback currently points to
+
+void server_trace::start(const server_trace_params & params, int32_t id_slot, llama_context * ctx, std::function<void()> flush_fn, std::function<bool()> alive_fn) {
+    stop();
+    p = params;
+    if (!p.enabled()) {
+        return;
+    }
+    this->id_slot  = id_slot;
+    this->flush_fn = std::move(flush_fn);
+    this->alive_fn = std::move(alive_fn);
+    this->ctx      = ctx;
+    const llama_model * model = llama_get_model(ctx);
+    n_layer   = llama_model_n_layer(model);
+    n_head_kv = llama_model_n_head_kv(model);
+    n_embd    = llama_model_n_embd(model);
+    n_vocab   = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    saw_layers  = false;
+    lens_failed = false;
+    lens_ok     = p.deep && llama_trace_logit_lens(ctx, nullptr, 0, nullptr) == 0;
+    {
+        events    = json::array();
+        caps_sent = false;
+    }
+    attn = ATTN_NONE;
+    ub_i = -1;
+    prefill_n = 0;
+    t_prefill = 0;
+    prefill_batches.clear();
+    no_stages = false;
+    step_busy = false;
+    step_own  = false;
+    if (p.step != SERVER_TRACE_STEP_NONE) {
+        std::lock_guard<std::mutex> lock(g_step.m);
+        if (g_step.owner < 0) {
+            g_step.owner = id_slot;
+            g_step.acks  = 0;
+            g_step.cont  = false;
+            step_own = true;
+        } else {
+            step_busy = true;
+            p.step = SERVER_TRACE_STEP_NONE;
+        }
+    }
+}
+
+void server_trace::stop() {
+    if (step_own) {
+        {
+            std::lock_guard<std::mutex> lock(g_step.m);
+            g_step.owner   = -1;
+            g_step.waiting = false;
+        }
+        g_step.cv.notify_all();
+        step_own = false;
+    }
+    p = server_trace_params();
+    flush_fn = nullptr;
+    alive_fn = nullptr;
+}
+
+void server_trace::emit(json && ev) {
+    events.push_back(std::move(ev));
+}
+
+server_trace_payload server_trace::take() {
+    server_trace_payload res;
+    if (!events.empty()) {
+        res.events = std::move(events);
+        events = json::array();
+    }
+    if (!caps_sent) {
+        caps_sent = true;
+        json caps = json::array();
+        if (p.detail == SERVER_TRACE_FULL && attn == ATTN_NONE) {
+            caps.push_back("no_attn");
+        }
+        if (p.detail == SERVER_TRACE_FULL && no_stages) {
+            caps.push_back("no_sample_stages");
+        }
+        if (step_busy) {
+            caps.push_back("no_step"); // another request holds step mode
+        }
+        if (p.deep && !lens_ok) {
+            caps.push_back("no_lens"); // no output head the lens can reach
+        }
+        if (p.deep && !saw_layers) {
+            caps.push_back("no_nodes"); // graph nodes are not named <name>-<il>
+        }
+        res.caps    = std::move(caps);
+        res.id_slot = id_slot;
+    }
+    res.t_ns = trace_now_ns();
+    return res;
+}
+
+// flush what we have to the client and block until acked (step mode)
+void server_trace::wait_step(const char * granularity) {
+    if (!step_own) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(g_step.m);
+        if (g_step.cont) {
+            return; // the client left step mode: run freely, events ride on the token chunks again
+        }
+    }
+    if (flush_fn) {
+        flush_fn();
+    }
+    std::unique_lock<std::mutex> lock(g_step.m);
+    if (g_step.cont) {
+        return;
+    }
+    g_step.waiting        = true;
+    g_step.at_granularity = granularity;
+    g_step.at_step        = strcmp(granularity, "sample") == 0 ? sample_step : step;
+    g_step.at_layer       = strcmp(granularity, "layer") == 0 ? cur_layer : -1;
+    // wait in slices so a client that went away (its HTTP handler stopped waiting for results)
+    // releases the server at once instead of after every remaining timeout
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(p.step_timeout_ms);
+    bool ok = false;
+    for (;;) {
+        const auto left  = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - std::chrono::steady_clock::now());
+        const auto slice = std::min(left, std::chrono::milliseconds(250));
+        if (g_step.cv.wait_for(lock, std::max(slice, std::chrono::milliseconds(0)), [] {
+                return g_step.acks > 0 || g_step.cont || g_step.owner < 0;
+            })) {
+            ok = true;
+            break;
+        }
+        if (std::chrono::steady_clock::now() >= deadline) {
+            break;
+        }
+        lock.unlock();
+        const bool alive = !alive_fn || alive_fn();
+        lock.lock();
+        if (!alive) {
+            g_step.cont = true; // leave step mode for the rest of this request
+            ok = true;
+            break;
+        }
+    }
+    g_step.waiting = false;
+    g_step.at_stage.clear();
+    if (g_step.acks > 0) {
+        g_step.acks--;
+    }
+    const int32_t at_step = g_step.at_step;
+    lock.unlock();
+    if (!ok) {
+        json ev = trace_ev("step.timeout");
+        ev["step"]        = at_step;
+        ev["granularity"] = granularity;
+        emit(std::move(ev));
+    }
+    t_last = trace_now_ns(); // do not charge the wait to the next op
+    t_layer = t_last;
+}
+
+//
+// forward pass
+//
+
+void server_trace::before_decode(llama_context * ctx, bool prefill, int32_t step, int32_t pos_first, int32_t pos_last, int32_t n_tokens) {
+    GGML_UNUSED(n_tokens);
+    this->prefill = prefill;
+    this->step    = step;
+    this->pos     = pos_last;
+    cur_layer = -1;
+    in_ub     = false;
+    layer_dev = nullptr;
+    t_last    = trace_now_ns();
+    t_layer   = t_last;
+    std::fill(std::begin(ops), std::end(ops), 0.0);
+    row_prev.clear();
+    moe_ids.clear();
+    moe_w.clear();
+    deep_layer      = -1;
+    deep_list_layer = -1;
+    deep_nodes.clear();
+    deep_cur        = nullptr;
+    op_pending      = 0.0;
+    if (p.deep) {
+        lens_rows.assign((size_t) n_layer*n_embd, 0.0f);
+        lens_have.assign(n_layer, 0);
+    }
+
+    if (prefill) {
+        if (t_prefill == 0) {
+            t_prefill = t_last;
+        }
+        pass_from = pos_first;
+        observe   = true; // at least the last layer, for the prefill.batch boundaries
+    } else {
+        observe = step < 8 || step % p.layer_stride == 0 || (step_own && p.step == SERVER_TRACE_STEP_LAYER);
+    }
+
+    if (observe) {
+        llama_set_eval_callback(ctx, eval_cb, this);
+        g_installed = this;
+    }
+}
+
+void server_trace::after_decode(llama_context * ctx) {
+    if (g_installed) {
+        llama_set_eval_callback(ctx, nullptr, nullptr);
+        g_installed = nullptr;
+    }
+    // deep: logit lens of every layer in one graph, after the pass (step mode runs it per layer instead)
+    if (p.deep && observe && !prefill && lens_ok) {
+        int first = -1;
+        for (int il = 0; il < n_layer; ++il) {
+            if (lens_have[il]) {
+                first = first < 0 ? il : first;
+            }
+        }
+        if (first >= 0) {
+            lens_run(first, n_layer - first);
+        }
+    }
+}
+
+void server_trace::prefill_done() {
+    const int64_t now = trace_now_ns();
+    const int32_t of  = (int32_t) prefill_batches.size();
+    for (auto & ev : prefill_batches) {
+        ev["of"] = std::max(of, 1);
+        emit(std::move(ev));
+    }
+    prefill_batches.clear();
+    json ev = trace_ev("prefill.done");
+    ev["n_tokens"] = prefill_n;
+    ev["ms"]       = ns_to_ms(t_prefill ? now - t_prefill : 0);
+    emit(std::move(ev));
+}
+
+bool server_trace::want(const ggml_tensor * t, const char * b, int il) const {
+    const bool full = p.detail == SERVER_TRACE_FULL;
+    if (strcmp(b, "l_out") == 0 && il >= 0) {
+        return prefill ? (full || il == n_layer - 1) : true;
+    }
+    if (prefill || !full) {
+        return false;
+    }
+    const bool is_attn = t->op == GGML_OP_FLASH_ATTN_EXT || strcmp(b, "kq_soft_max") == 0;
+    if (is_attn) {
+        return true; // timing; the weights are read only on every attn_layers-th layer
+    }
+    if (il < 0) {
+        return strcmp(b, "embd") == 0; // layer 0 input, for its residual delta
+    }
+    if (strcmp(b, "ffn_moe_topk") == 0 || trace_is_moe_weights(b)) {
+        return true; // read back (ffn_moe_topk is a view of the argsort)
+    }
+    // op boundaries; views (e.g. the pre-RoPE Qcur/Kcur/Vcur reshapes, kqv_out with FA) are skipped,
+    // their segment is charged to the next observed node, which in llama-family graphs has the same op
+    return trace_op_of(t, b) >= 0 && !trace_is_view(t);
+}
+
+bool server_trace::eval_cb(ggml_tensor * t, bool ask, void * user_data) {
+    auto * tr = (server_trace *) user_data;
+
+    char base[GGML_MAX_NAME];
+    int  il = -1;
+    const bool named = trace_parse_name(t->name, base, sizeof(base), il);
+    const bool deep  = tr->p.deep && !tr->prefill;
+    if (!named) {
+        base[0] = '\0';
+        il      = -1;
+        if (t->op != GGML_OP_FLASH_ATTN_EXT && !deep) {
+            return ask ? false : true;
+        }
+    }
+    if (t->op == GGML_OP_FLASH_ATTN_EXT && il < 0) {
+        il = tr->cur_layer; // the fused attention node is unnamed; it belongs to the layer being built
+    }
+    const bool tracked = named || t->op == GGML_OP_FLASH_ATTN_EXT; // the full-detail logic knows this node
+
+    if (ask) {
+        bool need = false;
+        if (tracked) {
+            if (il >= 0) {
+                tr->cur_layer  = il;
+                tr->saw_layers = true;
+                if (il == 0 && !tr->in_ub) {
+                    // first node of a new ubatch (the scheduler asks before it computes)
+                    tr->in_ub   = true;
+                    tr->ub_i   += tr->prefill ? 1 : 0;
+                    tr->t_ub    = trace_now_ns();
+                    tr->t_last  = tr->t_ub;
+                    tr->t_layer = tr->t_ub;
+                }
+                if (il == 0 && strcmp(base, "l_out") == 0) {
+                    tr->ub_ntok = (int32_t) t->ne[1];
+                }
+            }
+            // the layer runs where its weights are: the first weight matmul of the layer decides (the
+            // scheduler may still put weight-less ops such as the residual add on a neighbouring GPU)
+            if ((t->op == GGML_OP_MUL_MAT || t->op == GGML_OP_MUL_MAT_ID) && !tr->layer_dev && tr->cur_layer >= 0 &&
+                    t->src[0] && t->src[0]->buffer && ggml_backend_buffer_get_usage(t->src[0]->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS) {
+                tr->layer_dev = trace_device(t->src[0]);
+            }
+            if (t->op == GGML_OP_FLASH_ATTN_EXT) {
+                tr->attn = ATTN_FLASH;
+            } else if (strcmp(base, "kq_soft_max") == 0) {
+                tr->attn = ATTN_SOFTMAX;
+            }
+            need = tr->want(t, base, il);
+        }
+        if (deep) {
+            need = tr->deep_ask(t, named, il) || need;
+        }
+        return need;
+    }
+
+    const int64_t now = trace_now_ns();
+    const double  seg = ns_to_ms(now - tr->t_last);
+    tr->t_last = now;
+
+    if (!tr->prefill) {
+        // a decode segment is charged to the op of the node it ends at; at deep, segments that end at
+        // other nodes are carried to the next op node (as the unobserved nodes are at full)
+        const int op = tracked ? trace_op_of(t, base) : -1;
+        if (op >= 0) {
+            tr->ops[op]   += seg + tr->op_pending;
+            tr->op_pending = 0.0;
+        } else if (deep) {
+            tr->op_pending += seg;
+        }
+    }
+    if (deep && t == tr->deep_cur) {
+        tr->deep_node(t, base, seg);
+    }
+    if (tracked) {
+        tr->on_observed(t, base, il, now);
+    }
+
+    // do not charge our own readback / reduction time (or a step-mode wait) to the next segment
+    const int64_t spent = trace_now_ns() - tr->t_last;
+    tr->t_last  += spent;
+    tr->t_layer += spent;
+    tr->t_ub    += spent;
+    return true; // keep computing
+}
+
+void server_trace::on_observed(ggml_tensor * t, const char * b, int il, int64_t now) {
+    const bool full = p.detail == SERVER_TRACE_FULL;
+
+    if (prefill) {
+        if (strcmp(b, "l_out") != 0 || il < 0) {
+            return;
+        }
+        if (full) {
+            json ev = trace_ev("prefill.layer");
+            ev["batch_i"] = std::max(ub_i, 0);
+            ev["layer"]   = il;
+            ev["ms"]      = ns_to_ms(now - t_layer);
+            emit(std::move(ev));
+        }
+        t_layer   = now;
+        layer_dev = nullptr;
+        if (il == n_layer - 1) {
+            in_ub = false;
+            json ev = trace_ev("prefill.batch");
+            ev["batch_i"] = std::max(ub_i, 0);
+            ev["of"]      = 1; // filled in by prefill_done()
+            ev["from"]    = pass_from;
+            ev["to"]      = pass_from + ub_ntok;
+            ev["ms"]      = ns_to_ms(now - t_ub);
+            prefill_batches.push_back(std::move(ev));
+            pass_from += ub_ntok;
+            prefill_n += ub_ntok;
+        }
+        return;
+    }
+
+    // decode
+
+    if (strcmp(b, "embd") == 0) {
+        trace_read_row(t, t->ne[1] - 1, 0, row_prev);
+        return;
+    }
+    if (il < 0) {
+        return;
+    }
+
+    if (full && (il % p.attn_layers == 0 || p.deep)) {
+        if (t->op == GGML_OP_FLASH_ATTN_EXT) {
+            attn_flash(t, il);
+        } else if (strcmp(b, "kq_soft_max") == 0) {
+            attn_softmax(t, il);
+        }
+    }
+
+    if (strcmp(b, "ffn_moe_topk") == 0 && t->type == GGML_TYPE_I32) {
+        moe_ids.resize(t->ne[0]);
+        ggml_backend_tensor_get(t, moe_ids.data(), (t->ne[1] - 1)*t->nb[1], t->ne[0]*sizeof(int32_t));
+        return;
+    }
+    if (trace_is_moe_weights(b) && t->type == GGML_TYPE_F32) {
+        // [1, n_expert_used, n_tokens] or [n_expert_used, n_tokens]
+        const int64_t n  = t->ne[0] == 1 ? t->ne[1] : t->ne[0];
+        const size_t  nb = t->ne[0] == 1 ? t->nb[2] : t->nb[1];
+        const int64_t nt = t->ne[0] == 1 ? t->ne[2] : t->ne[1];
+        moe_w.resize(n);
+        ggml_backend_tensor_get(t, moe_w.data(), (nt - 1)*nb, n*sizeof(float));
+        return;
+    }
+
+    if (strcmp(b, "l_out") != 0) {
+        return;
+    }
+
+    // end of layer il
+    json ev = trace_ev("decode.layer");
+    ev["step"]   = step;
+    ev["layer"]  = il;
+    ev["ms"]     = ns_to_ms(now - t_layer);
+    ev["device"] = layer_dev ? layer_dev : trace_device(t);
+    layer_dev    = nullptr;
+    t_layer = now;
+
+    if (full) {
+        if (trace_read_row(t, t->ne[1] - 1, 0, row_cur)) {
+            if (p.deep && (int32_t) row_cur.size() == n_embd && il < n_layer) {
+                std::copy(row_cur.begin(), row_cur.end(), lens_rows.begin() + (size_t) il*n_embd);
+                lens_have[il] = 1;
+            }
+            const float norm  = trace_l2(row_cur.data(), nullptr, row_cur.size());
+            const float delta = row_prev.size() == row_cur.size() ? trace_l2(row_cur.data(), row_prev.data(), row_cur.size()) : norm;
+            ev["norm"] = norm;
+            emit(std::move(ev));
+
+            json res = trace_ev("decode.residual");
+            res["step"]       = step;
+            res["layer"]      = il;
+            res["norm"]       = norm;
+            res["delta_norm"] = delta;
+            emit(std::move(res));
+            std::swap(row_prev, row_cur);
+        } else {
+            emit(std::move(ev));
+        }
+
+        for (int o = 0; o < OP_COUNT; ++o) {
+            if (ops[o] > 0.0) {
+                json oe = trace_ev("decode.op");
+                oe["step"]  = step;
+                oe["layer"] = il;
+                oe["op"]    = OP_NAMES[o];
+                oe["ms"]    = std::round(ops[o]*1e4)/1e4;
+                emit(std::move(oe));
+            }
+        }
+
+        json kv = trace_ev("decode.kv.write");
+        kv["step"]  = step;
+        kv["layer"] = il;
+        kv["pos"]   = pos;
+        emit(std::move(kv));
+
+        if (!moe_ids.empty()) {
+            json experts = json::array();
+            for (size_t i = 0; i < moe_ids.size(); ++i) {
+                experts.push_back({{"id", moe_ids[i]}, {"w", i < moe_w.size() ? moe_w[i] : 0.0f}});
+            }
+            json me = trace_ev("decode.moe");
+            me["step"]    = step;
+            me["layer"]   = il;
+            me["experts"] = std::move(experts);
+            emit(std::move(me));
+            moe_ids.clear();
+            moe_w.clear();
+        }
+    } else {
+        emit(std::move(ev));
+    }
+    std::fill(std::begin(ops), std::end(ops), 0.0);
+    op_pending = 0.0;
+
+    if (p.step == SERVER_TRACE_STEP_LAYER) {
+        if (p.deep && lens_ok && step_own && il < n_layer && lens_have[il]) {
+            lens_run(il, 1); // step mode: the lens of this layer before the pause
+            lens_have[il] = 0;
+        }
+        wait_step("layer");
+    }
+}
+
+// kq_soft_max: [n_kv, n_tokens, n_head, n_stream] f32, already softmaxed and masked
+void server_trace::attn_softmax(ggml_tensor * t, int il) {
+    if (t->type != GGML_TYPE_F32) {
+        return;
+    }
+    const int64_t n_kv = t->ne[0], n_head = t->ne[2], tok = t->ne[1] - 1;
+    std::vector<float> avg(n_kv, 0.0f), row;
+    std::vector<uint8_t> host;
+    trace_read_all(t, host); // one transfer for all heads
+    std::vector<std::vector<float>> heads;
+    for (int64_t h = 0; h < n_head; ++h) {
+        if (!trace_read_row(t, tok, h, row, host.data())) {
+            return;
+        }
+        for (int64_t j = 0; j < n_kv; ++j) {
+            avg[j] += row[j] / n_head;
+        }
+        if (p.attn_heads || p.deep) {
+            heads.push_back(row);
+        }
+    }
+    attn_emit(il, avg, heads, n_head_kv);
+}
+
+// flash attention: the softmaxed KQ row never exists, so rebuild it on the CPU for the current
+// token from the node's inputs: q [d, n_tokens, n_head], k [d, n_kv, n_head_kv] (KV cache view),
+// mask [n_kv, n_tokens_pad] and the scale / softcap op params (same math as the CPU kernel,
+// attention sinks and ALiBi are ignored)
+void server_trace::attn_flash(ggml_tensor * t, int il) {
+    const ggml_tensor * q = t->src[0];
+    const ggml_tensor * k = t->src[1];
+    const ggml_tensor * m = t->src[3];
+    if (!q || !k || q->ne[0] != k->ne[0] || q->ne[3] != 1 || k->ne[3] != 1) {
+        return;
+    }
+    const int64_t d = q->ne[0], n_head = q->ne[2], n_kv = k->ne[1], n_head_kv = k->ne[2];
+    const int64_t tok = q->ne[1] - 1;
+    if (n_head_kv <= 0 || n_head % n_head_kv != 0) {
+        return;
+    }
+    float scale = 1.0f, max_bias = 0.0f, softcap = 0.0f;
+    memcpy(&scale,    (const float *) t->op_params + 0, sizeof(float));
+    memcpy(&max_bias, (const float *) t->op_params + 1, sizeof(float));
+    memcpy(&softcap,  (const float *) t->op_params + 2, sizeof(float));
+    GGML_UNUSED(max_bias);
+    if (softcap != 0.0f) {
+        scale /= softcap;
+    }
+
+    // whole K view in one transfer, then convert the unmasked cells once per KV head
+    const auto * kt = ggml_get_type_traits(k->type);
+    if (k->type != GGML_TYPE_F32 && !kt->to_float) {
+        return;
+    }
+    std::vector<float> mask;
+    if (m && !trace_read_row(m, tok, 0, mask)) {
+        mask.clear();
+    }
+    auto masked = [&](int64_t j) { return j < (int64_t) mask.size() && mask[j] == -INFINITY; };
+
+    // the view spans the whole n_kv (padded, up to the cache size): transfer only up to the last unmasked cell
+    int64_t n_used = n_kv;
+    while (n_used > 0 && masked(n_used - 1)) {
+        n_used--;
+    }
+    std::vector<uint8_t> kbuf(ggml_nbytes(k));
+    if (n_used > 0) {
+        ggml_backend_tensor_get(k, kbuf.data(), 0, std::min(ggml_nbytes(k), (size_t) ((n_used - 1)*k->nb[1] + (n_head_kv - 1)*k->nb[2] + ggml_row_size(k->type, d))));
+    }
+    std::vector<float> kf((size_t) n_head_kv*n_kv*d);
+    for (int64_t g = 0; g < n_head_kv; ++g) {
+        for (int64_t j = 0; j < n_used; ++j) {
+            if (masked(j)) {
+                continue; // other sequences' cells and the padding past the last used cell
+            }
+            const uint8_t * kp = kbuf.data() + j*k->nb[1] + g*k->nb[2];
+            float * dst = kf.data() + ((size_t) g*n_kv + j)*d;
+            if (k->type == GGML_TYPE_F32) {
+                memcpy(dst, kp, d*sizeof(float));
+            } else {
+                kt->to_float(kp, dst, d);
+            }
+        }
+    }
+
+    std::vector<float> qrow, s(n_kv), avg(n_kv, 0.0f);
+    std::vector<uint8_t> qbuf;
+    trace_read_all(q, qbuf); // one transfer for all heads
+    std::vector<std::vector<float>> heads;
+    for (int64_t h = 0; h < n_head; ++h) {
+        if (!trace_read_row(q, tok, h, qrow, qbuf.data())) {
+            return;
+        }
+        const int64_t g = h / (n_head / n_head_kv);
+        float s_max = -INFINITY;
+        for (int64_t j = 0; j < n_kv; ++j) {
+            if (masked(j)) {
+                s[j] = -INFINITY;
+                continue;
+            }
+            const float * krow = kf.data() + ((size_t) g*n_kv + j)*d;
+            double dot = 0.0;
+            for (int64_t i = 0; i < d; ++i) {
+                dot += (double) qrow[i]*krow[i];
+            }
+            float v = (float) dot*scale;
+            if (softcap != 0.0f) {
+                v = softcap*tanhf(v);
+            }
+            if (j < (int64_t) mask.size()) {
+                v += mask[j];
+            }
+            s[j]  = v;
+            s_max = std::max(s_max, v);
+        }
+        if (!std::isfinite(s_max)) {
+            if (p.attn_heads || p.deep) {
+                heads.emplace_back(n_kv, 0.0f); // fully masked: keep the head index aligned
+            }
+            continue;
+        }
+        double sum = 0.0;
+        for (int64_t j = 0; j < n_kv; ++j) {
+            s[j] = std::isinf(s[j]) ? 0.0f : expf(s[j] - s_max);
+            sum += s[j];
+        }
+        for (int64_t j = 0; j < n_kv; ++j) {
+            s[j] = (float) (s[j]/sum);
+            avg[j] += s[j]/n_head;
+        }
+        if (p.attn_heads || p.deep) {
+            heads.push_back(s);
+        }
+    }
+    attn_emit(il, avg, heads, n_head_kv);
+}
+
+void server_trace::attn_emit(int il, const std::vector<float> & w_avg, const std::vector<std::vector<float>> & w_heads, int64_t n_kv_head) {
+    auto top = [&](const std::vector<float> & w) {
+        std::vector<int32_t> idx(w.size());
+        for (size_t i = 0; i < idx.size(); ++i) {
+            idx[i] = (int32_t) i;
+        }
+        const size_t k = std::min<size_t>(p.attn_topk, idx.size());
+        std::partial_sort(idx.begin(), idx.begin() + k, idx.end(), [&](int32_t a, int32_t b) { return w[a] > w[b]; });
+        json res = json::array();
+        for (size_t i = 0; i < k; ++i) {
+            res.push_back({{"pos", idx[i]}, {"w", w[idx[i]]}});
+        }
+        return res;
+    };
+    if (il % p.attn_layers == 0) {
+        json ev = trace_ev("decode.attn");
+        ev["step"]  = step;
+        ev["layer"] = il;
+        ev["top"]   = top(w_avg);
+        emit(std::move(ev));
+        for (size_t h = 0; p.attn_heads && h < w_heads.size(); ++h) {
+            json he = trace_ev("decode.attn");
+            he["step"]  = step;
+            he["layer"] = il;
+            he["head"]  = (int) h;
+            he["top"]   = top(w_heads[h]);
+            emit(std::move(he));
+        }
+    }
+    if (p.deep && !w_heads.empty()) {
+        // the KV view is padded past the last used cell; trailing cells masked for every head are not
+        // positions of this sequence, so n_kv = last cell with weight > 0 in any head, + 1
+        size_t n_kv = 0;
+        for (const auto & w : w_heads) {
+            for (size_t j = w.size(); j > n_kv; --j) {
+                if (w[j - 1] > 0.0f) {
+                    n_kv = j;
+                    break;
+                }
+            }
+        }
+        const size_t from = n_kv > (size_t) p.attn_window ? n_kv - p.attn_window : 0;
+        json rows = json::array();
+        for (const auto & w : w_heads) {
+            json row = json::array();
+            for (size_t j = from; j < n_kv; ++j) {
+                row.push_back(j < w.size() ? std::round((double) w[j]*1e4)/1e4 : 0.0);
+            }
+            rows.push_back(std::move(row));
+        }
+        json ev = trace_ev("decode.attn.heads");
+        ev["step"]      = step;
+        ev["layer"]     = il;
+        ev["from"]      = (int64_t) from;
+        ev["n_kv_head"] = n_kv_head;
+        ev["rows"]      = std::move(rows);
+        emit(std::move(ev));
+    }
+}
+
+//
+// deep detail: every node of each decode layer, logit lens
+//
+
+// layer membership of a decode node: named nodes carry their layer, the others belong to the layer that
+// is open (nodes after l_out-<L> go to layer L+1; nodes before the first layer and after the last are
+// outside). View-only nodes are never observed, the scheduler computes them with the next segment.
+bool server_trace::deep_ask(const ggml_tensor * t, bool named, int il) {
+    deep_cur = nullptr;
+    const int L = (named && il >= 0) ? il : deep_layer;
+    if (named && il >= 0) {
+        deep_layer = il;
+    }
+    if (L < 0 || L >= n_layer) {
+        return false;
+    }
+    if (named && il >= 0 && strncmp(t->name, "l_out-", 6) == 0) {
+        deep_layer = il + 1 < n_layer ? il + 1 : -1; // close the layer
+    }
+    if (trace_is_view(t) || t->op == GGML_OP_NONE) {
+        return false;
+    }
+    if (L != deep_list_layer) {
+        deep_list_layer = L;
+        deep_nodes.clear();
+    }
+    deep_cur       = t;
+    deep_cur_layer = L;
+    return true;
+}
+
+static std::string trace_lower(const char * s) {
+    std::string r = s;
+    for (auto & c : r) {
+        c = (char) tolower((unsigned char) c);
+    }
+    return r;
+}
+
+// min/max/mean/rms over the result (decode: one token, so the whole tensor); false for results that alias
+// another buffer (SET_ROWS / CPY into the KV cache), non-float or non-contiguous results, and > 1M elements
+static bool trace_stats(const ggml_tensor * t, json & out) {
+    const int64_t n = ggml_nelements(t);
+    if (t->view_src || n <= 0 || n > (1 << 20) || !ggml_is_contiguous(t) ||
+            (t->type != GGML_TYPE_F32 && t->type != GGML_TYPE_F16 && t->type != GGML_TYPE_BF16)) {
+        return false;
+    }
+    std::vector<uint8_t> raw(ggml_nbytes(t));
+    ggml_backend_tensor_get(t, raw.data(), 0, raw.size());
+    std::vector<float> v;
+    const float * x = (const float *) raw.data();
+    if (t->type != GGML_TYPE_F32) {
+        v.resize(n);
+        ggml_get_type_traits(t->type)->to_float(raw.data(), v.data(), n);
+        x = v.data();
+    }
+    double mn = INFINITY, mx = -INFINITY, sum = 0.0, sq = 0.0;
+    int64_t cnt = 0;
+    for (int64_t i = 0; i < n; ++i) {
+        const double a = x[i];
+        if (!std::isfinite(a)) {
+            continue; // e.g. masked scores; the stats are over the finite values
+        }
+        mn   = std::min(mn, a);
+        mx   = std::max(mx, a);
+        sum += a;
+        sq  += a*a;
+        cnt++;
+    }
+    if (cnt == 0) {
+        return false;
+    }
+    out = json{{"min", (float) mn}, {"max", (float) mx}, {"mean", (float) (sum/cnt)}, {"rms", (float) std::sqrt(sq/cnt)}};
+    return true;
+}
+
+void server_trace::deep_node(const ggml_tensor * t, const char * base, double seg) {
+    const int32_t i = (int32_t) deep_nodes.size();
+    deep_nodes.push_back(t);
+
+    json shape = json::array();
+    int nd = GGML_MAX_DIMS;
+    while (nd > 1 && t->ne[nd - 1] == 1) {
+        nd--;
+    }
+    for (int d = 0; d < nd; ++d) {
+        shape.push_back(t->ne[d]);
+    }
+
+    // sources that are nodes of this layer; a view source is resolved to the tensor it views
+    json src = json::array();
+    std::vector<int32_t> seen;
+    for (int k = 0; k < GGML_MAX_SRC; ++k) {
+        const ggml_tensor * s = t->src[k];
+        if (!s) {
+            continue;
+        }
+        if (s->view_src) {
+            s = s->view_src;
+        }
+        for (int32_t j = 0; j < i; ++j) {
+            if (deep_nodes[j] == s) {
+                if (std::find(seen.begin(), seen.end(), j) == seen.end()) {
+                    seen.push_back(j);
+                    src.push_back(j);
+                }
+                break;
+            }
+        }
+    }
+
+    json ev = trace_ev("decode.node");
+    ev["step"]  = step;
+    ev["layer"] = deep_cur_layer;
+    ev["i"]     = i;
+    // unnamed nodes have no name, or the "node_<n>" ggml_graph_print-style name the graph gave them
+    const bool unnamed = !base || !base[0] || (strncmp(base, "node_", 5) == 0 && strspn(base + 5, "0123456789") == strlen(base + 5));
+    ev["name"]  = unnamed ? trace_lower(ggml_op_desc(t)) : std::string(base);
+    ev["op"]    = ggml_op_desc(t);
+    ev["shape"] = std::move(shape);
+    ev["ms"]    = seg;
+    if (!src.empty()) {
+        ev["src"] = std::move(src);
+    }
+    json stats;
+    if (trace_stats(t, stats)) {
+        ev["stats"] = std::move(stats);
+    }
+    emit(std::move(ev));
+    deep_cur = nullptr;
+}
+
+// token piece as valid UTF-8 (byte-level BPE pieces can be partial characters): invalid bytes -> U+FFFD
+static std::string trace_utf8(const std::string & s) {
+    std::string r;
+    size_t i = 0;
+    while (i < s.size()) {
+        const unsigned char c = (unsigned char) s[i];
+        const size_t len = c < 0x80 ? 1 : (c >> 5) == 0x6 ? 2 : (c >> 4) == 0xE ? 3 : (c >> 3) == 0x1E ? 4 : 0;
+        bool ok = len > 0 && i + len <= s.size();
+        for (size_t k = 1; ok && k < len; ++k) {
+            ok = ((unsigned char) s[i + k] >> 6) == 0x2;
+        }
+        if (ok) {
+            r.append(s, i, len);
+            i += len;
+        } else {
+            r += "\xEF\xBF\xBD";
+            i += 1;
+        }
+    }
+    return r;
+}
+
+// logit lens of layers [il_first, il_first + n): one graph through output_norm + output on the head's
+// backend, then softmax / entropy / top-k per row on the CPU (rows in parallel)
+void server_trace::lens_run(int il_first, int n) {
+    if (lens_failed || n <= 0 || n_vocab <= 0) {
+        return;
+    }
+    lens_logits.resize((size_t) n*n_vocab);
+    if (llama_trace_logit_lens(ctx, lens_rows.data() + (size_t) il_first*n_embd, n, lens_logits.data()) != 0) {
+        lens_failed = true;
+        SRV_WRN("%s", "trace: logit lens failed, no decode.lens for the rest of this request\n");
+        return;
+    }
+    struct res_t {
+        std::vector<std::pair<float, int32_t>> top; // p, id
+        double entropy = 0.0;
+    };
+    std::vector<res_t> res(n);
+    const int K = p.lens_topk;
+    auto work = [&](int r) {
+        if (!lens_have[il_first + r]) {
+            return;
+        }
+        const float * x = lens_logits.data() + (size_t) r*n_vocab;
+        float mx = -INFINITY;
+        for (int32_t j = 0; j < n_vocab; ++j) {
+            mx = std::max(mx, x[j]);
+        }
+        double z = 0.0, ex = 0.0;
+        using item = std::pair<float, int32_t>;
+        std::priority_queue<item, std::vector<item>, std::greater<item>> heap;
+        float thr = -INFINITY;
+        for (int32_t j = 0; j < n_vocab; ++j) {
+            const double e = std::exp((double) x[j] - mx);
+            z  += e;
+            ex += e*x[j];
+            if ((int) heap.size() < K) {
+                heap.push({ x[j], j });
+                thr = heap.top().first;
+            } else if (x[j] > thr) {
+                heap.pop();
+                heap.push({ x[j], j });
+                thr = heap.top().first;
+            }
+        }
+        const double log_z = mx + std::log(z);
+        res[r].entropy = log_z - ex/z; // H = log Z - E_p[x]
+        while (!heap.empty()) {
+            res[r].top.push_back({ (float) std::exp((double) heap.top().first - log_z), heap.top().second });
+            heap.pop();
+        }
+        std::reverse(res[r].top.begin(), res[r].top.end());
+    };
+    const int n_thr = std::max(1, std::min<int>({ n, 8, (int) std::thread::hardware_concurrency() }));
+    std::vector<std::thread> pool;
+    for (int ti = 0; ti < n_thr; ++ti) {
+        pool.emplace_back([&, ti]() {
+            for (int r = ti; r < n; r += n_thr) {
+                work(r);
+            }
+        });
+    }
+    for (auto & th : pool) {
+        th.join();
+    }
+    for (int r = 0; r < n; ++r) {
+        if (!lens_have[il_first + r]) {
+            continue;
+        }
+        json top = json::array();
+        for (const auto & [pr, id] : res[r].top) {
+            top.push_back({{"id", id}, {"p", pr}, {"text", trace_utf8(common_token_to_piece(ctx, id, true))}});
+        }
+        json ev = trace_ev("decode.lens");
+        ev["step"]    = step;
+        ev["layer"]   = il_first + r;
+        ev["top"]     = std::move(top);
+        ev["entropy"] = (float) std::max(0.0, res[r].entropy);
+        emit(std::move(ev));
+    }
+}
+
+//
+// sampling
+//
+
+void server_trace::sample_begin(common_sampler * smpl, int32_t step) {
+    sample_step = step;
+    draw = -1.0;
+    // stages are a full-detail event; sample step mode needs them at any detail
+    if (p.detail == SERVER_TRACE_FULL || p.step == SERVER_TRACE_STEP_SAMPLE) {
+        common_sampler_set_stage_cb(smpl, stage_cb, this);
+    }
+}
+
+void server_trace::sample_end(common_sampler * smpl, llama_token id, const common_params_sampling & sparams) {
+    common_sampler_set_stage_cb(smpl, nullptr, nullptr);
+
+    // the last sampler of the chain picks the token
+    std::string method = "dist";
+    llama_sampler * chain = common_sampler_get(smpl);
+    if (chain && llama_sampler_chain_n(chain) > 0) {
+        method = trace_stage_name(llama_sampler_name(llama_sampler_chain_get(chain, llama_sampler_chain_n(chain) - 1)));
+    }
+    if (sparams.backend_sampling) {
+        no_stages = true;
+    }
+
+    json ev = trace_ev("decode.sample");
+    ev["step"]      = sample_step;
+    ev["chosen_id"] = id;
+    ev["temp"]      = sparams.temp;
+    ev["top_p"]     = sparams.top_p;
+    ev["top_k"]     = sparams.top_k;
+    ev["method"]    = method;
+    emit(std::move(ev));
+}
+
+void server_trace::stage_cb(llama_sampler * smpl, const char * stage, const llama_token_data_array * cur_p, bool pre, void * user_data) {
+    auto * tr = (server_trace *) user_data;
+    if (stage[0] == '?') {
+        return; // llama_sampler_init_empty(): a sampler disabled by its params, a no-op
+    }
+    const std::string name = trace_stage_name(stage);
+
+    if (pre) {
+        // recover the uniform draw of the distribution sampler: a clone shares its RNG state, and
+        // applied to K equal candidates it selects floor(K*u)
+        if (name == "dist" && smpl && cur_p->size > 1) {
+            constexpr int K = 8192;
+            llama_sampler * c = llama_sampler_clone(smpl);
+            std::vector<llama_token_data> probe(K);
+            for (int i = 0; i < K; ++i) {
+                probe[i] = { i, 0.0f, 0.0f };
+            }
+            llama_token_data_array arr = { probe.data(), (size_t) K, -1, false };
+            llama_sampler_apply(c, &arr);
+            llama_sampler_free(c);
+            tr->draw = arr.selected >= 0 ? (arr.selected + 0.5) / K : -1.0;
+        }
+        return;
+    }
+
+    auto emit_stage = [&](const char * sname, json && cands, int32_t cutoff, double draw) {
+        json ev = trace_ev("decode.sample.stage");
+        ev["step"]       = tr->sample_step;
+        ev["stage"]      = sname;
+        ev["candidates"] = std::move(cands);
+        ev["cutoff"]     = cutoff;
+        if (draw >= 0.0) {
+            ev["draw"] = draw;
+        }
+        tr->emit(std::move(ev));
+        if (tr->p.step == SERVER_TRACE_STEP_SAMPLE && tr->step_own) {
+            {
+                std::lock_guard<std::mutex> lock(g_step.m);
+                g_step.at_stage = sname;
+            }
+            tr->wait_step("sample");
+        }
+    };
+
+    int32_t n_alive = 0;
+    if (name == "dist" || name == "greedy" || name == "mirostat" || name == "mirostat_v2" || name == "adaptive_p") {
+        const bool has_p = name != "greedy";
+        if (has_p) {
+            // probabilities after the final normalisation
+            json cands = trace_top_candidates(cur_p, tr->p.sample_topn, true, n_alive);
+            emit_stage("softmax", std::move(cands), n_alive, -1.0);
+        }
+        json chosen = json::array();
+        if (cur_p->selected >= 0 && (size_t) cur_p->selected < cur_p->size) {
+            const auto & d = cur_p->data[cur_p->selected];
+            chosen.push_back({{"id", d.id}, {"v", has_p ? d.p : d.logit}});
+        }
+        emit_stage("draw", std::move(chosen), (int32_t) cur_p->selected, name == "dist" ? tr->draw : -1.0);
+        return;
+    }
+
+    json cands = trace_top_candidates(cur_p, tr->p.sample_topn, false, n_alive);
+    emit_stage(name.c_str(), std::move(cands), n_alive, -1.0);
+}
