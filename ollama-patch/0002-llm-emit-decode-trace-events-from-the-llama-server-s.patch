--- /dev/null
+++ b/llm/llama_server_trace_test.go
@@ -0,0 +1,47 @@
+package llm
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestUserLogprobsHidesTraceProbs(t *testing.T) {
+	top := make([]llamaServerTokenProb, 10)
+	for i := range top {
+		top[i] = llamaServerTokenProb{ID: i, Token: "t", Logprob: -float64(i)}
+	}
+	probs := []llamaServerTokenProb{{ID: 1, Token: "a", Logprob: -0.1, TopLogprobs: top}}
+
+	if got := userLogprobs(probs, false, 0); got != nil {
+		t.Fatalf("client did not ask for logprobs, got %v", got)
+	}
+	if got := userLogprobs(probs, true, 0); len(got) != 1 || len(got[0].TopLogprobs) != 0 {
+		t.Fatalf("logprobs without top: %+v", got)
+	}
+	if got := userLogprobs(probs, true, 3); len(got[0].TopLogprobs) != 3 {
+		t.Fatalf("top_logprobs not truncated to 3: %d", len(got[0].TopLogprobs))
+	}
+}
+
+func TestTraceCandidates(t *testing.T) {
+	c := traceCandidates(llamaServerTokenProb{TopLogprobs: []llamaServerTokenProb{{ID: 7, Token: "x", Logprob: 0}}})
+	if len(c) != 1 || c[0].ID != 7 || c[0].P != 1 {
+		t.Fatalf("got %+v", c)
+	}
+	c = traceCandidates(llamaServerTokenProb{TopProbs: []llamaServerTokenProb{{ID: 8, Token: "y", Prob: 0.25}}})
+	if c[0].P != 0.25 {
+		t.Fatalf("got %+v", c)
+	}
+}
+
+func TestPieceText(t *testing.T) {
+	if got := pieceText(json.RawMessage(`"hi"`)); got != "hi" {
+		t.Fatal(got)
+	}
+	if got := pieceText(json.RawMessage(`[240,159,140,149]`)); got != "🌕" {
+		t.Fatal(got)
+	}
+	if got := f32(0.7); got != 0.7 {
+		t.Fatal(got)
+	}
+}
