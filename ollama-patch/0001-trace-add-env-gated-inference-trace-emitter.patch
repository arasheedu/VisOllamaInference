index 00000000..885113ca
--- /dev/null
+++ b/trace/trace_test.go
@@ -0,0 +1,331 @@
+package trace
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"slices"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/coder/websocket"
+)
+
+func testEmitter(t *testing.T) *emitter {
+	t.Helper()
+	return newEmitter(config{url: "ws://unused", stepTimeout: time.Second})
+}
+
+func drain(e *emitter) []map[string]any {
+	var out []map[string]any
+	for b := e.tryNext(); b != nil; b = e.tryNext() {
+		var m map[string]any
+		if err := json.Unmarshal(b, &m); err != nil {
+			panic(string(b) + ": " + err.Error())
+		}
+		out = append(out, m)
+	}
+	return out
+}
+
+func TestDisabledIsNoop(t *testing.T) {
+	t.Setenv("OLLAMA_TRACE_URL", "")
+	if tr := NewRequest("x", "", ""); tr != nil {
+		t.Fatal("expected nil tracer when OLLAMA_TRACE_URL is unset")
+	}
+	var tr *RequestTracer
+	ctx := context.Background()
+	allocs := testing.AllocsPerRun(100, func() {
+		tr.Received("m", 3, nil)
+		tr.ModelLoadStart(1, 2)
+		tr.Prefill(0, 4, time.Millisecond)
+		step := tr.StepStart(ctx, 1, 2)
+		tr.Sample(step, 1, 0.8, 0.9, 40, "dist")
+		tr.Token(ctx, "hi", false)
+		tr.Done(Stats{})
+		tr.End(true, "")
+		_ = FromContext(ctx)
+		_ = NewContext(ctx, tr)
+	})
+	if allocs != 0 {
+		t.Fatalf("nil tracer allocated %v times per run", allocs)
+	}
+}
+
+func TestSeqMonotonicAndEnvelope(t *testing.T) {
+	e := testEmitter(t)
+	tr := e.newRequest("req-1", "full", "")
+	ctx := context.Background()
+	tr.Received("llama3.2", 5, map[string]any{"temperature": 0.7})
+	tr.ModelLoadStart(28, 4096)
+	tr.ModelLoadDone(28, 4096, 2048, 800*time.Millisecond)
+	tr.TokenizeDone([]Token{{ID: 1, Text: "Hi"}})
+	tr.Prefill(0, 1, 12*time.Millisecond)
+	s := tr.StepStart(ctx, 1, 4096)
+	tr.Logits(s, []Candidate{{ID: 5, Text: "!", P: 0.6}, {ID: 6, Text: ".", P: 0.4}})
+	tr.Sample(s, 5, 0.7, 0.9, 40, "dist")
+	tr.Token(ctx, "!", false)
+	s = tr.StepStart(ctx, 2, 4096)
+	tr.MarkEOS()
+	tr.Token(ctx, "", true)
+	tr.Done(Stats{EvalCount: 2})
+	tr.Error("ignored after done")
+
+	evs := drain(e)
+	var last float64 = -1
+	var lastT float64 = -1
+	for _, ev := range evs {
+		if ev["v"] != 1.0 || ev["req"] != "req-1" {
+			t.Fatalf("bad envelope %v", ev)
+		}
+		seq := ev["seq"].(float64)
+		if seq != last+1 {
+			t.Fatalf("seq not contiguous: %v after %v", seq, last)
+		}
+		last = seq
+		tn := ev["t_ns"].(float64)
+		if tn < lastT {
+			t.Fatalf("t_ns went backwards")
+		}
+		lastT = tn
+	}
+	types := make([]string, len(evs))
+	for i, ev := range evs {
+		types[i] = ev["type"].(string)
+	}
+	want := []string{
+		"request.received", "model.load", "model.load", "tokenize.done", "prefill.batch", "prefill.done",
+		"decode.step.start", "decode.logits", "decode.sample", "decode.token", "stream.chunk",
+		"decode.step.start", "decode.token", "request.done",
+	}
+	if !slices.Equal(types, want) {
+		t.Fatalf("types\n got %v\nwant %v", types, want)
+	}
+	if evs[12]["is_eos"] != true || evs[12]["step"] != 1.0 {
+		t.Fatalf("eos token wrong: %v", evs[12])
+	}
+}
+
+// TestSchemaFieldNames pins payload keys to packages/trace-schema.
+func TestSchemaFieldNames(t *testing.T) {
+	e := testEmitter(t)
+	tr := e.newRequest("r", "full", "")
+	ctx := context.Background()
+	tr.Received("m", 1, nil)
+	tr.ModelLoadStart(1, 2)
+	tr.ModelLoadDone(1, 2, 3, time.Second)
+	tr.TokenizeDone(nil)
+	tr.Prefill(0, 1, time.Millisecond)
+	s := tr.StepStart(ctx, 1, 2)
+	tr.Logits(s, nil)
+	tr.Sample(s, 1, 1, 1, 1, "dist")
+	tr.Token(ctx, "a", false)
+	tr.Done(Stats{})
+	tr2 := e.newRequest("r2", "", "")
+	tr2.Error("boom")
+	tr2.emit("step.timeout", stepTimeout{Step: 0, Granularity: "token"})
+
+	env := []string{"v", "req", "seq", "t_ns", "type"}
+	want := map[string][]string{
+		"request.received":  {"model", "prompt_chars", "options", "detail", "capabilities"},
+		"model.load":        {"phase", "layers", "ctx", "vram_mb"},
+		"tokenize.done":     {"n", "tokens"},
+		"prefill.batch":     {"batch_i", "of", "from", "to", "ms"},
+		"prefill.done":      {"n_tokens", "ms"},
+		"decode.step.start": {"step", "kv_used", "kv_total"},
+		"decode.logits":     {"step", "topk", "entropy"},
+		"decode.sample":     {"step", "chosen_id", "temp", "top_p", "top_k", "method"},
+		"decode.token":      {"step", "text", "is_eos"},
+		"stream.chunk":      {"step", "bytes", "utf8_complete", "text"},
+		"request.done":      {"stats"},
+		"request.error":     {"message"},
+		"step.timeout":      {"step", "granularity"},
+	}
+	for _, ev := range drain(e) {
+		typ := ev["type"].(string)
+		keys, ok := want[typ]
+		if !ok {
+			t.Fatalf("unexpected type %s", typ)
+		}
+		for _, k := range append(env, keys...) {
+			if _, ok := ev[k]; !ok {
+				t.Errorf("%s missing %q: %v", typ, k, ev)
+			}
+		}
+		for k := range ev {
+			if !slices.Contains(env, k) && !slices.Contains(keys, k) && !(typ == "model.load" && k == "ms") {
+				t.Errorf("%s has unexpected key %q", typ, k)
+			}
+		}
+		if typ == "request.done" {
+			stats := ev["stats"].(map[string]any)
+			for _, k := range []string{"prompt_eval_count", "prompt_eval_ms", "eval_count", "eval_ms", "load_ms", "total_ms"} {
+				if _, ok := stats[k]; !ok {
+					t.Errorf("stats missing %q", k)
+				}
+			}
+		}
+		if typ == "tokenize.done" && ev["tokens"] == nil {
+			t.Error("tokens must be an array, not null")
+		}
+		if typ == "request.received" {
+			if _, ok := ev["options"].(map[string]any); !ok {
+				t.Error("options must be an object")
+			}
+		}
+	}
+}
+
+func TestDropPolicyKeepsCritical(t *testing.T) {
+	e := testEmitter(t)
+	for range queueCap {
+		e.enqueue([]byte(`{"n":"fill"}`), false)
+	}
+	e.enqueue([]byte(`{"n":"droppable"}`), false)
+	e.enqueue([]byte(`{"n":"crit1"}`), true)
+	e.enqueue([]byte(`{"n":"droppable2"}`), false)
+	e.enqueue([]byte(`{"n":"crit2"}`), true)
+	if got := e.dropped.Load(); got != 2 {
+		t.Fatalf("dropped = %d, want 2", got)
+	}
+	var names []string
+	for b := e.tryNext(); b != nil; b = e.tryNext() {
+		names = append(names, string(b))
+	}
+	if len(names) != queueCap+2 {
+		t.Fatalf("got %d events", len(names))
+	}
+	if names[queueCap] != `{"n":"crit1"}` || names[queueCap+1] != `{"n":"crit2"}` {
+		t.Fatalf("critical events lost or reordered: %v", names[queueCap:])
+	}
+	// overflow drained: the fast path is usable again
+	e.enqueue([]byte(`{"n":"after"}`), false)
+	if b := e.tryNext(); string(b) != `{"n":"after"}` {
+		t.Fatalf("got %s", b)
+	}
+}
+
+func TestStepModeAckAndTimeout(t *testing.T) {
+	e := newEmitter(config{url: "ws://unused", stepTimeout: 50 * time.Millisecond})
+	e.connected.Store(true)
+	ctx := context.Background()
+
+	tr := e.newRequest("step-req", "", "token")
+	if !tr.Stepping() {
+		t.Fatal("expected step mode")
+	}
+	if other := e.newRequest("other", "", "token"); other.Stepping() {
+		t.Fatal("only one request may be in step mode")
+	}
+
+	// timeout path
+	start := time.Now()
+	tr.StepStart(ctx, 0, 0)
+	if time.Since(start) < 40*time.Millisecond {
+		t.Fatal("step did not wait")
+	}
+
+	// ack releases one step
+	go func() {
+		time.Sleep(10 * time.Millisecond)
+		e.handleControl([]byte(`{"v":1,"type":"ack","req":"step-req","granularity":"token"}`))
+	}()
+	start = time.Now()
+	tr.StepStart(ctx, 1, 0)
+	if d := time.Since(start); d > 45*time.Millisecond {
+		t.Fatalf("ack did not release the step (%v)", d)
+	}
+
+	// continue leaves step mode for good
+	e.handleControl([]byte(`{"v":1,"type":"ack","req":"step-req","continue":true}`))
+	tr.StepStart(ctx, 2, 0) // consumes the buffered ack
+	if tr.Stepping() {
+		t.Fatal("continue should release step mode")
+	}
+	start = time.Now()
+	tr.StepStart(ctx, 3, 0)
+	if time.Since(start) > 20*time.Millisecond {
+		t.Fatal("free-running step blocked")
+	}
+	tr.End(true, "")
+	if e.stepOwner.Load() != nil {
+		t.Fatal("step owner not released")
+	}
+
+	var timeouts int
+	for _, ev := range drain(e) {
+		if ev["type"] == "step.timeout" {
+			timeouts++
+			if ev["step"] != 0.0 || ev["granularity"] != "token" {
+				t.Fatalf("bad step.timeout %v", ev)
+			}
+		}
+	}
+	if timeouts != 1 {
+		t.Fatalf("got %d step.timeout events, want 1", timeouts)
+	}
+}
+
+func TestWebSocketRoundTrip(t *testing.T) {
+	got := make(chan string, 100)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		c, err := websocket.Accept(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer c.CloseNow()
+		for {
+			_, data, err := c.Read(r.Context())
+			if err != nil {
+				return
+			}
+			for line := range strings.SplitSeq(string(data), "\n") {
+				got <- line
+				if strings.Contains(line, `"decode.step.start"`) || strings.Contains(line, `"request.received"`) {
+					_ = c.Write(r.Context(), websocket.MessageText, []byte(`{"v":1,"type":"ack","req":"ws-req"}`))
+				}
+			}
+		}
+	}))
+	defer srv.Close()
+
+	e := newEmitter(config{url: "ws" + strings.TrimPrefix(srv.URL, "http") + "/ingest", stepTimeout: 5 * time.Second})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	go e.run(ctx)
+	deadline := time.Now().Add(5 * time.Second)
+	for !e.connected.Load() && time.Now().Before(deadline) {
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	tr := e.newRequest("ws-req", "", "token")
+	tr.Received("m", 1, nil)
+	start := time.Now()
+	tr.StepStart(ctx, 0, 0) // released by the ack for request.received
+	tr.StepStart(ctx, 1, 0) // released by the ack sent for step 0
+	if time.Since(start) > 4*time.Second {
+		t.Fatal("ack over websocket did not release the step")
+	}
+	tr.End(true, "")
+
+	var types []string
+	timeout := time.After(5 * time.Second)
+	for len(types) < 5 {
+		select {
+		case line := <-got:
+			var m map[string]any
+			if err := json.Unmarshal([]byte(line), &m); err != nil {
+				t.Fatalf("bad line %q", line)
+			}
+			types = append(types, m["type"].(string))
+		case <-timeout:
+			t.Fatalf("only received %v", types)
+		}
+	}
+	want := []string{"request.received", "decode.step.start", "decode.token", "decode.step.start", "decode.token"}
+	if !slices.Equal(types, want) {
+		t.Fatalf("got %v want %v", types, want)
+	}
+}
