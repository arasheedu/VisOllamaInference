+// Package trace streams inference trace events to an LLM inference
+// visualizer over a WebSocket. It is disabled, and every call is a cheap
+// no-op, unless OLLAMA_TRACE_URL is set.
+//
+// Events follow the v1 schema in packages/trace-schema of the visualizer:
+// {v:1, req, seq, t_ns, type, ...payload}, one JSON object per line.
+package trace
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"log/slog"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/coder/websocket"
+
+	"github.com/ollama/ollama/envconfig"
+)
+
+const (
+	// queueCap bounds the ordered event queue. When it is full, droppable
+	// events are discarded and critical events spill into the overflow list.
+	queueCap = 10000
+	// overflowCap bounds the critical overflow so a hub that never drains
+	// cannot grow memory without limit.
+	overflowCap = 200000
+	// disconnectGrace is how long events are kept while the hub is
+	// unreachable before they are discarded.
+	disconnectGrace = 5 * time.Second
+
+	maxBatchEvents = 256
+	maxBatchBytes  = 256 << 10
+	writeTimeout   = 10 * time.Second
+	dialTimeout    = 5 * time.Second
+	minBackoff     = 250 * time.Millisecond
+	maxBackoff     = 5 * time.Second
+)
+
+// critical mirrors PRIORITY in packages/trace-schema: critical events are
+// never dropped by the emitter; everything else is droppable.
+var critical = map[string]bool{
+	"request.received":    true,
+	"model.load":          true,
+	"tokenize.done":       true,
+	"prefill.batch":       true,
+	"prefill.done":        true,
+	"decode.step.start":   true,
+	"decode.logits":       true,
+	"decode.sample":       true,
+	"decode.token":        true,
+	"request.done":        true,
+	"request.error":       true,
+	"decode.sample.stage": true,
+	"step.timeout":        true,
+}
+
+type config struct {
+	url         string
+	detail      Detail
+	step        string
+	stepTimeout time.Duration
+}
+
+type emitter struct {
+	cfg  config
+	base time.Time // monotonic origin for t_ns
+
+	queue chan []byte
+	wake  chan struct{}
+
+	mu          sync.Mutex
+	overflow    [][]byte
+	overflowLen atomic.Int64
+
+	dropped   atomic.Uint64
+	connected atomic.Bool
+
+	waiters   sync.Map // req id -> *RequestTracer in step mode
+	stepOwner atomic.Pointer[RequestTracer]
+}
+
+var (
+	global   *emitter
+	initOnce sync.Once
+)
+
+// Init reads the OLLAMA_TRACE_* environment and, when OLLAMA_TRACE_URL is set,
+// starts the background writer. It is safe to call more than once; the first
+// traced request calls it implicitly.
+func Init() { get() }
+
+func get() *emitter {
+	initOnce.Do(func() {
+		url := envconfig.TraceURL()
+		if url == "" {
+			return
+		}
+		detail, _ := ParseDetail(envconfig.TraceDetail())
+		global = newEmitter(config{
+			url:         url,
+			detail:      detail,
+			step:        envconfig.TraceStep(),
+			stepTimeout: envconfig.TraceStepTimeout(),
+		})
+		slog.Info("inference tracing enabled", "url", url, "detail", detail.String())
+		go global.run(context.Background())
+	})
+	return global
+}
+
+// Enabled reports whether tracing is configured.
+func Enabled() bool { return get() != nil }
+
+func newEmitter(cfg config) *emitter {
+	if cfg.stepTimeout <= 0 {
+		cfg.stepTimeout = 60 * time.Second
+	}
+	return &emitter{
+		cfg:   cfg,
+		base:  time.Now(),
+		queue: make(chan []byte, queueCap),
+		wake:  make(chan struct{}, 1),
+	}
+}
+
+// enqueue never blocks. Order is preserved: once the overflow list holds
+// anything, new events go there too until the writer has drained it.
+func (e *emitter) enqueue(b []byte, crit bool) {
+	if e.overflowLen.Load() == 0 {
+		select {
+		case e.queue <- b:
+			return
+		default:
+		}
+	}
+	if !crit {
+		e.dropped.Add(1)
+		return
+	}
+	e.mu.Lock()
+	if len(e.overflow) >= overflowCap {
+		e.mu.Unlock()
+		e.dropped.Add(1)
+		return
+	}
+	e.overflow = append(e.overflow, b)
+	e.overflowLen.Store(int64(len(e.overflow)))
+	e.mu.Unlock()
+	select {
+	case e.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (e *emitter) popOverflow() []byte {
+	if e.overflowLen.Load() == 0 {
+		return nil
+	}
+	e.mu.Lock()
+	defer e.mu.Unlock()
+	if len(e.overflow) == 0 {
+		return nil
+	}
+	b := e.overflow[0]
+	e.overflow[0] = nil
+	e.overflow = e.overflow[1:]
+	e.overflowLen.Store(int64(len(e.overflow)))
+	return b
+}
+
+// tryNext returns the next queued event without blocking. The queue holds
+// older events than the overflow list, so it is drained first.
+func (e *emitter) tryNext() []byte {
+	select {
+	case b := <-e.queue:
+		return b
+	default:
+		return e.popOverflow()
+	}
+}
+
+func (e *emitter) next(ctx context.Context) []byte {
+	for {
+		if b := e.tryNext(); b != nil {
+			return b
+		}
+		select {
+		case b := <-e.queue:
+			return b
+		case <-e.wake:
+		case <-ctx.Done():
+			return nil
+		}
+	}
+}
+
+// batch joins the first event with whatever else is already queued into one
+// newline-delimited WebSocket message.
+func (e *emitter) batch(first []byte) []byte {
+	buf := append([]byte(nil), first...)
+	for n := 1; n < maxBatchEvents && len(buf) < maxBatchBytes; n++ {
+		b := e.tryNext()
+		if b == nil {
+			break
+		}
+		buf = append(buf, '\n')
+		buf = append(buf, b...)
+	}
+	return buf
+}
+
+func (e *emitter) discard() {
+	for e.tryNext() != nil {
+		e.dropped.Add(1)
+	}
+}
+
+func (e *emitter) run(ctx context.Context) {
+	backoff := minBackoff
+	disconnectedAt := time.Now()
+	warned := false
+	var pending []byte
+
+	for ctx.Err() == nil {
+		dctx, cancel := context.WithTimeout(ctx, dialTimeout)
+		conn, _, err := websocket.Dial(dctx, e.cfg.url, nil)
+		cancel()
+		if err != nil {
+			if !warned {
+				slog.Warn("trace hub unreachable, retrying quietly", "url", e.cfg.url, "error", err)
+				warned = true
+			}
+			if time.Since(disconnectedAt) > disconnectGrace {
+				pending = nil
+				e.discard()
+			}
+			select {
+			case <-time.After(backoff):
+			case <-ctx.Done():
+				return
+			}
+			backoff = min(backoff*2, maxBackoff)
+			continue
+		}
+
+		slog.Info("trace hub connected", "url", e.cfg.url)
+		warned = false
+		backoff = minBackoff
+		conn.SetReadLimit(1 << 20)
+		e.connected.Store(true)
+
+		cctx, cancelConn := context.WithCancel(ctx)
+		go e.readLoop(cctx, cancelConn, conn)
+		err = e.writeLoop(cctx, conn, &pending)
+		e.connected.Store(false)
+		disconnectedAt = time.Now()
+		cancelConn()
+		conn.CloseNow()
+		slog.Info("trace hub disconnected", "error", err, "dropped", e.dropped.Load())
+	}
+}
+
+func (e *emitter) writeLoop(ctx context.Context, conn *websocket.Conn, pending *[]byte) error {
+	for {
+		if *pending == nil {
+			b := e.next(ctx)
+			if b == nil {
+				return ctx.Err()
+			}
+			*pending = e.batch(b)
+		}
+		wctx, cancel := context.WithTimeout(ctx, writeTimeout)
+		err := conn.Write(wctx, websocket.MessageText, *pending)
+		cancel()
+		if err != nil {
+			return err // keep pending so it is resent after reconnecting
+		}
+		*pending = nil
+	}
+}
+
+func (e *emitter) readLoop(ctx context.Context, cancel context.CancelFunc, conn *websocket.Conn) {
+	defer cancel()
+	for {
+		typ, data, err := conn.Read(ctx)
+		if err != nil {
+			return
+		}
+		if typ != websocket.MessageText {
+			continue
+		}
+		for line := range bytes.SplitSeq(data, []byte("\n")) {
+			e.handleControl(line)
+		}
+	}
+}
+
+// ackMessage mirrors AckMessage in packages/trace-schema.
+type ackMessage struct {
+	V           int    `json:"v"`
+	Type        string `json:"type"`
+	Req         string `json:"req"`
+	Granularity string `json:"granularity,omitempty"`
+	Continue    bool   `json:"continue,omitempty"`
+}
+
+func (e *emitter) handleControl(line []byte) {
+	line = bytes.TrimSpace(line)
+	if len(line) == 0 {
+		return
+	}
+	var msg ackMessage
+	if err := json.Unmarshal(line, &msg); err != nil || msg.V != 1 || msg.Type != "ack" {
+		return
+	}
+	if v, ok := e.waiters.Load(msg.Req); ok {
+		v.(*RequestTracer).ack(msg.Continue)
+	}
+}
+
+func stepEnabled(s string) bool {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "", "0", "false", "off", "no":
+		return false
+	}
+	return true
+}
diff --git a/trace/trace_test.go b/trace/trace_test.go
