--- /dev/null
+++ b/trace/tracer.go
@@ -0,0 +1,504 @@
+package trace
+
+import (
+	"context"
+	"encoding/json"
+	"log/slog"
+	"math"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+	"unicode/utf8"
+
+	"github.com/google/uuid"
+)
+
+// Detail is the trace detail level requested for a request.
+type Detail int
+
+const (
+	Basic Detail = iota
+	Layers
+	Full
+)
+
+func (d Detail) String() string {
+	switch d {
+	case Layers:
+		return "layers"
+	case Full:
+		return "full"
+	default:
+		return "basic"
+	}
+}
+
+// ParseDetail parses basic|layers|full. Unknown values yield Basic, false.
+func ParseDetail(s string) (Detail, bool) {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "basic":
+		return Basic, true
+	case "layers":
+		return Layers, true
+	case "full":
+		return Full, true
+	}
+	return Basic, false
+}
+
+// Header names the visualizer sends with /api/chat and /api/generate.
+const (
+	HeaderRequestID = "X-Trace-Request-Id"
+	HeaderDetail    = "X-Trace-Detail"
+	HeaderStep      = "X-Trace-Step"
+)
+
+// RequestTracer emits the events of one request. A nil *RequestTracer is
+// valid and every method on it is a no-op.
+//
+// Step, token and terminal methods are meant to be called from the single
+// goroutine that drives the request's response stream.
+type RequestTracer struct {
+	e       *emitter
+	req     string
+	reqJSON []byte
+	detail  Detail
+	stepReq string
+	seq     atomic.Int64
+
+	stepping atomic.Bool
+	ackCh    chan struct{}
+	finished atomic.Bool
+	start    time.Time
+
+	step      int // current decode step, -1 before the first
+	tokenSent bool
+	eos       bool
+}
+
+// NewRequest returns a tracer for one request, or nil when tracing is
+// disabled. id, detail and step are the X-Trace-* header values; an empty id
+// gets a generated UUID and empty detail/step fall back to the environment.
+func NewRequest(id, detail, step string) *RequestTracer {
+	e := get()
+	if e == nil {
+		return nil
+	}
+	return e.newRequest(id, detail, step)
+}
+
+func (e *emitter) newRequest(id, detail, step string) *RequestTracer {
+	if id == "" {
+		id = uuid.NewString()
+	}
+	d := e.cfg.detail
+	if v, ok := ParseDetail(detail); ok {
+		d = v
+	}
+	if step == "" {
+		step = e.cfg.step
+	}
+	reqJSON, _ := json.Marshal(id)
+	t := &RequestTracer{e: e, req: id, reqJSON: reqJSON, detail: d, start: time.Now(), step: -1}
+	if stepEnabled(step) {
+		t.stepReq = strings.ToLower(strings.TrimSpace(step))
+		if e.stepOwner.CompareAndSwap(nil, t) {
+			t.ackCh = make(chan struct{}, 1)
+			t.stepping.Store(true)
+			e.waiters.Store(id, t)
+		} else {
+			slog.Warn("trace step mode already in use by another request; running freely", "req", id)
+		}
+	}
+	return t
+}
+
+type ctxKey struct{}
+
+// NewContext returns ctx carrying t. A nil t returns ctx unchanged.
+func NewContext(ctx context.Context, t *RequestTracer) context.Context {
+	if t == nil {
+		return ctx
+	}
+	return context.WithValue(ctx, ctxKey{}, t)
+}
+
+// FromContext returns the request tracer in ctx, or nil.
+func FromContext(ctx context.Context) *RequestTracer {
+	if ctx == nil {
+		return nil
+	}
+	t, _ := ctx.Value(ctxKey{}).(*RequestTracer)
+	return t
+}
+
+// ID returns the trace request id.
+func (t *RequestTracer) ID() string {
+	if t == nil {
+		return ""
+	}
+	return t.req
+}
+
+// Detail returns the detail level for this request.
+func (t *RequestTracer) Detail() Detail {
+	if t == nil {
+		return Basic
+	}
+	return t.detail
+}
+
+// Stepping reports whether the request is currently in step mode.
+func (t *RequestTracer) Stepping() bool { return t != nil && t.stepping.Load() }
+
+func (t *RequestTracer) emit(typ string, payload any) {
+	body, err := json.Marshal(payload)
+	if err != nil {
+		slog.Debug("trace marshal failed", "type", typ, "error", err)
+		return
+	}
+	seq := t.seq.Add(1) - 1
+	tns := time.Since(t.e.base).Nanoseconds()
+
+	buf := make([]byte, 0, 64+len(t.reqJSON)+len(typ)+len(body))
+	buf = append(buf, `{"v":1,"req":`...)
+	buf = append(buf, t.reqJSON...)
+	buf = append(buf, `,"seq":`...)
+	buf = strconv.AppendInt(buf, seq, 10)
+	buf = append(buf, `,"t_ns":`...)
+	buf = strconv.AppendInt(buf, tns, 10)
+	buf = append(buf, `,"type":"`...)
+	buf = append(buf, typ...)
+	buf = append(buf, '"')
+	if len(body) > 2 {
+		buf = append(buf, ',')
+		buf = append(buf, body[1:]...)
+	} else {
+		buf = append(buf, '}')
+	}
+	t.e.enqueue(buf, critical[typ])
+}
+
+// ---- payloads (field names mirror packages/trace-schema) -----------------
+
+type requestReceived struct {
+	Model        string         `json:"model"`
+	PromptChars  int            `json:"prompt_chars"`
+	Options      map[string]any `json:"options"`
+	Detail       string         `json:"detail"`
+	Capabilities []string       `json:"capabilities,omitempty"`
+}
+
+type modelLoad struct {
+	Phase  string   `json:"phase"`
+	Layers int      `json:"layers"`
+	Ctx    int      `json:"ctx"`
+	VramMB float64  `json:"vram_mb"`
+	MS     *float64 `json:"ms,omitempty"`
+}
+
+// Token is a prompt token for tokenize.done.
+type Token struct {
+	ID   int    `json:"id"`
+	Text string `json:"text"`
+}
+
+type tokenizeDone struct {
+	N      int     `json:"n"`
+	Tokens []Token `json:"tokens"`
+}
+
+type prefillBatch struct {
+	BatchI int     `json:"batch_i"`
+	Of     int     `json:"of"`
+	From   int     `json:"from"`
+	To     int     `json:"to"`
+	MS     float64 `json:"ms"`
+}
+
+type prefillDone struct {
+	NTokens int     `json:"n_tokens"`
+	MS      float64 `json:"ms"`
+}
+
+type decodeStepStart struct {
+	Step    int `json:"step"`
+	KVUsed  int `json:"kv_used"`
+	KVTotal int `json:"kv_total"`
+}
+
+// Candidate is one top-k entry for decode.logits.
+type Candidate struct {
+	ID   int     `json:"id"`
+	Text string  `json:"text"`
+	P    float64 `json:"p"`
+}
+
+type decodeLogits struct {
+	Step    int         `json:"step"`
+	TopK    []Candidate `json:"topk"`
+	Entropy float64     `json:"entropy"`
+}
+
+type decodeSample struct {
+	Step     int     `json:"step"`
+	ChosenID int     `json:"chosen_id"`
+	Temp     float64 `json:"temp"`
+	TopP     float64 `json:"top_p"`
+	TopK     int     `json:"top_k"`
+	Method   string  `json:"method"`
+}
+
+type decodeToken struct {
+	Step  int    `json:"step"`
+	Text  string `json:"text"`
+	IsEOS bool   `json:"is_eos"`
+}
+
+type streamChunk struct {
+	Step         int    `json:"step"`
+	Bytes        int    `json:"bytes"`
+	UTF8Complete bool   `json:"utf8_complete"`
+	Text         string `json:"text"`
+}
+
+// Stats is the request.done payload; all durations are milliseconds.
+type Stats struct {
+	PromptEvalCount int     `json:"prompt_eval_count"`
+	PromptEvalMS    float64 `json:"prompt_eval_ms"`
+	EvalCount       int     `json:"eval_count"`
+	EvalMS          float64 `json:"eval_ms"`
+	LoadMS          float64 `json:"load_ms"`
+	TotalMS         float64 `json:"total_ms"`
+}
+
+type requestDone struct {
+	Stats Stats `json:"stats"`
+}
+
+type requestError struct {
+	Message string `json:"message"`
+}
+
+type stepTimeout struct {
+	Step        int    `json:"step"`
+	Granularity string `json:"granularity"`
+}
+
+// ---- events ---------------------------------------------------------------
+
+// Capabilities lists what this emitter cannot provide. Everything below the
+// HTTP boundary of llama-server needs a patched llama.cpp (see
+// ollama-patch/NOTES.md).
+func (t *RequestTracer) Capabilities() []string {
+	caps := []string{
+		"no_layers", "no_ops", "no_residual", "no_attn", "no_kv_writes",
+		"no_sample_stages", "no_tokenize_merge", "prefill_synthesized",
+	}
+	if t != nil && (t.stepReq == "layer" || t.stepReq == "sample") {
+		caps = append(caps, "step_token_only")
+	}
+	return caps
+}
+
+// Received emits request.received.
+func (t *RequestTracer) Received(model string, promptChars int, options map[string]any) {
+	if t == nil {
+		return
+	}
+	if options == nil {
+		options = map[string]any{}
+	}
+	t.emit("request.received", requestReceived{
+		Model: model, PromptChars: promptChars, Options: options,
+		Detail: t.detail.String(), Capabilities: t.Capabilities(),
+	})
+}
+
+// ModelLoadStart emits model.load phase=start.
+func (t *RequestTracer) ModelLoadStart(layers, ctx int) {
+	if t == nil {
+		return
+	}
+	t.emit("model.load", modelLoad{Phase: "start", Layers: max(layers, 0), Ctx: max(ctx, 0)})
+}
+
+// ModelLoadDone emits model.load phase=done.
+func (t *RequestTracer) ModelLoadDone(layers, ctx int, vramMB float64, d time.Duration) {
+	if t == nil {
+		return
+	}
+	ms := durMS(d)
+	t.emit("model.load", modelLoad{Phase: "done", Layers: max(layers, 0), Ctx: max(ctx, 0), VramMB: math.Max(vramMB, 0), MS: &ms})
+}
+
+// TokenizeDone emits tokenize.done.
+func (t *RequestTracer) TokenizeDone(tokens []Token) {
+	if t == nil {
+		return
+	}
+	if tokens == nil {
+		tokens = []Token{}
+	}
+	t.emit("tokenize.done", tokenizeDone{N: len(tokens), Tokens: tokens})
+}
+
+// Prefill emits one synthesized prefill.batch covering prompt positions
+// [from, to) followed by prefill.done.
+func (t *RequestTracer) Prefill(from, to int, d time.Duration) {
+	if t == nil {
+		return
+	}
+	from, to = max(from, 0), max(to, 0)
+	if to < from {
+		to = from
+	}
+	ms := durMS(d)
+	t.emit("prefill.batch", prefillBatch{BatchI: 0, Of: 1, From: from, To: to, MS: ms})
+	t.emit("prefill.done", prefillDone{NTokens: to - from, MS: ms})
+}
+
+// StepStart begins a decode step and returns its index. In step mode it first
+// blocks until the visualizer acks, the step timeout expires or ctx ends.
+func (t *RequestTracer) StepStart(ctx context.Context, kvUsed, kvTotal int) int {
+	if t == nil {
+		return 0
+	}
+	t.closeStep()
+	next := t.step + 1
+	t.waitStep(ctx, next)
+	t.step = next
+	t.tokenSent = false
+	t.eos = false
+	t.emit("decode.step.start", decodeStepStart{Step: next, KVUsed: max(kvUsed, 0), KVTotal: max(kvTotal, 0)})
+	return next
+}
+
+// closeStep gives a step whose text the response parser held back an empty
+// decode.token so every step has one.
+func (t *RequestTracer) closeStep() {
+	if t.step >= 0 && !t.tokenSent {
+		t.emit("decode.token", decodeToken{Step: t.step, Text: "", IsEOS: false})
+		t.tokenSent = true
+	}
+}
+
+// Logits emits decode.logits. Entropy (nats) is computed over the given
+// candidates, so it is a truncated estimate when only the top-k is known.
+func (t *RequestTracer) Logits(step int, topk []Candidate) {
+	if t == nil {
+		return
+	}
+	if topk == nil {
+		topk = []Candidate{}
+	}
+	var h float64
+	for _, c := range topk {
+		if c.P > 0 {
+			h -= c.P * math.Log(c.P)
+		}
+	}
+	t.emit("decode.logits", decodeLogits{Step: step, TopK: topk, Entropy: round(h, 1e5)})
+}
+
+// Sample emits decode.sample.
+func (t *RequestTracer) Sample(step, chosenID int, temp, topP float64, topK int, method string) {
+	if t == nil {
+		return
+	}
+	t.emit("decode.sample", decodeSample{Step: step, ChosenID: chosenID, Temp: temp, TopP: topP, TopK: topK, Method: method})
+}
+
+// MarkEOS records that the current step sampled end-of-sequence.
+func (t *RequestTracer) MarkEOS() {
+	if t == nil {
+		return
+	}
+	t.eos = true
+}
+
+// Token emits decode.token for text that reached the client in one response
+// chunk (thinking + content), attributed to the current step. done marks the
+// final chunk of the response.
+func (t *RequestTracer) Token(ctx context.Context, text string, done bool) {
+	if t == nil {
+		return
+	}
+	if text == "" && !(done && t.eos && !t.tokenSent) {
+		return
+	}
+	if t.step < 0 {
+		// No llama-server step hooks on this path; still count tokens.
+		t.StepStart(ctx, 0, 0)
+	}
+	isEOS := done && t.eos
+	t.emit("decode.token", decodeToken{Step: t.step, Text: text, IsEOS: isEOS})
+	t.tokenSent = true
+	if t.detail >= Full && text != "" {
+		t.emit("stream.chunk", streamChunk{Step: t.step, Bytes: len(text), UTF8Complete: utf8.ValidString(text), Text: text})
+	}
+}
+
+// Done emits request.done. Only the first terminal event of a request is sent.
+func (t *RequestTracer) Done(s Stats) {
+	if t == nil || !t.finished.CompareAndSwap(false, true) {
+		return
+	}
+	t.closeStep()
+	t.emit("request.done", requestDone{Stats: s})
+}
+
+// Error emits request.error unless a terminal event was already sent.
+func (t *RequestTracer) Error(msg string) {
+	if t == nil || !t.finished.CompareAndSwap(false, true) {
+		return
+	}
+	t.emit("request.error", requestError{Message: msg})
+}
+
+// End releases step mode. If no terminal event was sent, it sends
+// request.done (ok) or request.error so the visualizer never waits forever.
+func (t *RequestTracer) End(ok bool, msg string) {
+	if t == nil {
+		return
+	}
+	if t.ackCh != nil {
+		t.stepping.Store(false)
+		t.e.waiters.CompareAndDelete(t.req, t)
+		t.e.stepOwner.CompareAndSwap(t, nil)
+	}
+	if ok {
+		t.Done(Stats{TotalMS: durMS(time.Since(t.start))})
+	} else {
+		t.Error(msg)
+	}
+}
+
+func (t *RequestTracer) waitStep(ctx context.Context, step int) {
+	if !t.stepping.Load() || !t.e.connected.Load() {
+		return
+	}
+	timer := time.NewTimer(t.e.cfg.stepTimeout)
+	defer timer.Stop()
+	select {
+	case <-t.ackCh:
+	case <-ctx.Done():
+	case <-timer.C:
+		t.emit("step.timeout", stepTimeout{Step: step, Granularity: "token"})
+	}
+}
+
+func (t *RequestTracer) ack(cont bool) {
+	if cont {
+		t.stepping.Store(false)
+	}
+	select {
+	case t.ackCh <- struct{}{}:
+	default:
+	}
+}
+
+func durMS(d time.Duration) float64 { return round(float64(d)/float64(time.Millisecond), 1e3) }
+
+func round(v, scale float64) float64 { return math.Round(v*scale) / scale }
