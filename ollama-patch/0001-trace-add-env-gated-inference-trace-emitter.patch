+// TraceStepTimeout returns how long a traced request in step mode waits for an
+// ack before continuing. Configured via OLLAMA_TRACE_STEP_TIMEOUT. Default 60s.
+func TraceStepTimeout() time.Duration {
+	timeout := 60 * time.Second
+	if s := Var("OLLAMA_TRACE_STEP_TIMEOUT"); s != "" {
+		if d, err := time.ParseDuration(s); err == nil {
+			timeout = d
+		} else if n, err := strconv.ParseInt(s, 10, 64); err == nil {
+			timeout = time.Duration(n) * time.Second
+		}
+	}
+	if timeout <= 0 {
+		return 60 * time.Second
+	}
+	return timeout
+}
