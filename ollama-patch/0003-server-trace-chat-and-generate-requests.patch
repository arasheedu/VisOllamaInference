index 00000000..8f062f98
--- /dev/null
+++ b/server/trace.go
@@ -0,0 +1,85 @@
+package server
+
+import (
+	"fmt"
+	"time"
+	"unicode/utf8"
+
+	"github.com/gin-gonic/gin"
+
+	"github.com/ollama/ollama/api"
+	"github.com/ollama/ollama/trace"
+)
+
+// startTrace attaches a request tracer to the request context when tracing is
+// enabled (OLLAMA_TRACE_URL). The visualizer correlates its own request with
+// the trace through the X-Trace-Request-Id header, which is echoed back.
+func startTrace(c *gin.Context) *trace.RequestTracer {
+	tr := trace.NewRequest(c.GetHeader(trace.HeaderRequestID), c.GetHeader(trace.HeaderDetail), c.GetHeader(trace.HeaderStep))
+	if tr == nil {
+		return nil
+	}
+	c.Request = c.Request.WithContext(trace.NewContext(c.Request.Context(), tr))
+	c.Header(trace.HeaderRequestID, tr.ID())
+	return tr
+}
+
+// endTrace makes sure every traced request ends with request.done or
+// request.error, including early returns that never reached the model.
+func endTrace(c *gin.Context, tr *trace.RequestTracer) {
+	if tr == nil {
+		return
+	}
+	switch status := c.Writer.Status(); {
+	case c.Request.Context().Err() != nil:
+		tr.End(false, "request canceled")
+	case status >= 400:
+		tr.End(false, fmt.Sprintf("request failed with HTTP status %d", status))
+	default:
+		tr.End(true, "")
+	}
+}
+
+func chatPromptChars(msgs []api.Message) int {
+	n := 0
+	for _, m := range msgs {
+		n += utf8.RuneCountInString(m.Content)
+	}
+	return n
+}
+
+// traceChunk emits decode.token for the text of one response chunk exactly as
+// it is sent to the client (thinking first, then content, matching their
+// order within a chunk), and request.done on the final chunk.
+func traceChunk(c *gin.Context, tr *trace.RequestTracer, thinking, content string, m api.Metrics, done bool) {
+	if tr == nil {
+		return
+	}
+	tr.Token(c.Request.Context(), thinking+content, done)
+	if done {
+		tr.Done(trace.Stats{
+			PromptEvalCount: m.PromptEvalCount,
+			PromptEvalMS:    durMS(m.PromptEvalDuration),
+			EvalCount:       m.EvalCount,
+			EvalMS:          durMS(m.EvalDuration),
+			LoadMS:          durMS(m.LoadDuration),
+			TotalMS:         durMS(m.TotalDuration),
+		})
+	}
+}
+
+func traceChatChunk(c *gin.Context, tr *trace.RequestTracer, res api.ChatResponse) {
+	if tr == nil {
+		return
+	}
+	traceChunk(c, tr, res.Message.Thinking, res.Message.Content, res.Metrics, res.Done)
+}
+
+func traceError(c *gin.Context, msg string) {
+	if c.Request == nil {
+		return
+	}
+	trace.FromContext(c.Request.Context()).Error(msg)
+}
+
+func durMS(d time.Duration) float64 { return float64(d.Microseconds()) / 1000 }
